---
interface Props { id: string; subject: string; ratio?: string; src?: string; alt?: string }
const { id, subject, ratio = '16 / 9', src, alt = subject } = Astro.props;
---
<div class="media-slot" data-media-slot={id} style={`--media-ratio: ${ratio}`}>
  {src ? <img src={src} alt={alt} loading="lazy" /> : <span class="sr-only">Image planned: {subject}</span>}
</div>
<style>
  .media-slot { width: 100%; aspect-ratio: var(--media-ratio); overflow: hidden; border: 1px solid currentColor; background: var(--color-surface-paper); color: var(--color-text-muted-paper); }
  img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
</style>


