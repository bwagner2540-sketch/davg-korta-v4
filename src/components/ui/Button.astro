---
/** Primary / outline control. Forest fill on Paper; outline on Ink/Forest. Radius is --radius-control only. */
interface Props {
  href?: string;
  tone?: 'dark' | 'paper';
  variant?: 'solid' | 'outline';
  size?: 'sm' | 'md';
  type?: 'button' | 'submit';
  class?: string;
}
const {
  href,
  tone = 'dark',
  variant = 'solid',
  size = 'md',
  type = 'button',
  class: className,
} = Astro.props;
const Tag = href ? 'a' : 'button';
const classes = [
  'inline-flex items-center justify-center no-underline font-body font-medium text-nav',
  size === 'sm' ? 'px-5 py-2.5' : 'px-6 py-3',
  variant === 'solid'
    ? tone === 'paper'
      ? 'bg-forest text-on-dark hover:opacity-90'
      : 'bg-paper text-on-paper hover:bg-cream-01'
    : tone === 'paper'
      ? 'border border-line-paper text-on-paper hover:border-on-paper'
      : 'border border-line-dark text-on-dark hover:border-on-dark',
  className,
];
---
<Tag href={href} type={href ? undefined : type} class:list={classes}>
  <slot />
</Tag>
