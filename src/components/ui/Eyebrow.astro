---
/** Optional factual label in IBM Plex Mono. Most sections need none. */
interface Props { tone?: 'dark' | 'paper'; rule?: boolean; class?: string }
const { tone = 'dark', rule = false, class: cls } = Astro.props;
---
<div class:list={['mono-label flex items-center gap-3', tone === 'paper' ? 'text-muted-paper' : 'text-muted-dark', cls]}>
  {rule && <span class="h-px w-6 bg-signal"></span>}<slot />
</div>
