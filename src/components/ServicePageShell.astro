---
import { railCredentials, services } from '../config/site';
interface Props { currentPath: string; chapters?: { id: string; label: string }[]; headerOffset?: string; }
const { currentPath, chapters = [], headerOffset = '0px' } = Astro.props;
const currentSlug = currentPath.split('/').filter(Boolean).at(-1);
const indexLabel = (index: number) => String(index + 1).padStart(2, '0');
---
<div class="service-frame" style={`--header-offset: ${headerOffset}`} data-service-frame>
  <aside class="service-rail" aria-label="Service navigation">
    <a class="rail-brand" href="/">
      <img src="/brand/davg-lockup-on-black.png" alt="DAVG, Denver AV Group" width="1024" height="384" />
    </a>
    <nav class="rail-nav" aria-label="Services">
      <p class="rail-kicker">Services</p>
      <ul class="service-list">
        {services.map(({ label, railLabel, href, slug }, index) => <li>
          <a href={slug === currentSlug ? currentPath : href} aria-current={slug === currentSlug ? 'page' : undefined}>
            <span class="rail-index">{indexLabel(index)}</span>
            <span class="rail-name">{railLabel}</span>
          </a>
          {slug === currentSlug && chapters.length > 0 && <ul class="chapter-nav" aria-label={`${label} chapters`}>
            {chapters.map(({ id, label: chapterLabel }) => <li><a href={`#${id}`} data-chapter={id}>{chapterLabel}</a></li>)}
          </ul>}
        </li>)}
      </ul>
    </nav>
    <div class="rail-foot">
      <a class="rail-contact" href="#inquiry">Begin a project</a>
      <p class="rail-credentials">{railCredentials.map((line) => <span>{line}</span>)}</p>
    </div>
  </aside>
  <div class="service-right">
    <details class="mobile-service-menu">
      <summary>Services and chapters</summary>
      <nav aria-label="Mobile services"><ul class="service-list">
        {services.map(({ label, railLabel, href, slug }, index) => <li>
          <a href={slug === currentSlug ? currentPath : href} aria-current={slug === currentSlug ? 'page' : undefined}>
            <span class="rail-index">{indexLabel(index)}</span>
            <span class="rail-name">{railLabel}</span>
          </a>
          {slug === currentSlug && <ul class="chapter-nav" aria-label={`Mobile ${label} chapters`}>
            {chapters.map(({ id, label: chapterLabel }) => <li><a href={`#${id}`} data-chapter={id}>{chapterLabel}</a></li>)}
          </ul>}
        </li>)}
      </ul></nav>
    </details>
    <div class="chapter-field"><slot /></div>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-service-frame]').forEach(frame => {
    const menu = frame.querySelector<HTMLDetailsElement>('details');
    menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
    const groups = [...frame.querySelectorAll<HTMLElement>('[data-chapter-group]')];
    let ticking = false;
    const update = () => {
      ticking = false;
      const within = frame.getBoundingClientRect();
      const position = Math.min(window.innerHeight * 0.3, 180);
      const active = within.top <= position && within.bottom > position
        ? groups.filter(group => group.getBoundingClientRect().top <= position).at(-1)?.id || groups[0]?.id : '';
      frame.querySelectorAll('[data-chapter]').forEach(link => {
        if (active && link.getAttribute('data-chapter') === active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>
<style>
.service-frame {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
  background: var(--color-surface-ink);
  color: var(--color-text-on-dark);
}
.service-rail {
  position: sticky;
  top: var(--header-offset);
  align-self: start;
  box-sizing: border-box;
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: var(--spacing-12) var(--spacing-8) var(--spacing-8);
  background: var(--color-surface-forest);
  color: var(--color-text-on-dark);
  border-right: 1px solid var(--color-border-dark);
  overflow: hidden;
}
.rail-brand {
  display: block;
  width: 132px;
  margin: 0;
  color: inherit;
  text-decoration: none;
}
.rail-brand img { display: block; width: 100%; height: auto; }
.rail-nav {
  display: flex;
  flex-direction: column;
  gap: 14px;
  min-height: 0;
  flex: 1;
  margin-top: var(--spacing-12);
  overflow-y: auto;
}
.rail-kicker { color: var(--color-text-muted-dark); }
.service-list,
.chapter-nav {
  list-style: none;
  margin: 0;
  padding: 0;
}
.service-list {
  display: grid;
  gap: 11px;
}
.service-list a,
.chapter-nav a,
.rail-contact {
  font-family: var(--font-body);
  text-decoration: none;
}
.service-list > li > a {
  display: flex;
  align-items: center;
  gap: 14px;
  color: var(--color-text-muted-dark);
  font-size: 15px;
  font-weight: 400;
  line-height: 1.3;
}
.rail-index {
  flex: 0 0 18px;
  width: 18px;
  font-family: var(--font-mono);
  font-size: var(--text-mono);
  letter-spacing: var(--text-mono--letter-spacing);
  line-height: var(--text-mono--line-height);
  color: var(--color-text-quiet-dark);
}
.rail-name { width: fit-content; }
.service-list > li > a[aria-current="page"] { color: var(--color-text-on-dark); }
.service-list > li > a[aria-current="page"] .rail-index { color: var(--color-accent-signal); }
.service-list > li > a[aria-current="page"] .rail-name {
  padding-bottom: 2px;
  border-bottom: 1px solid var(--color-accent-signal);
}
.chapter-nav {
  display: grid;
  gap: 8px;
  margin: 12px 0 4px 32px;
  padding-left: 14px;
  border-left: 1px solid var(--color-border-dark);
}
.chapter-nav a {
  display: flex;
  align-items: baseline;
  gap: 10px;
  width: 100%;
  color: var(--color-text-muted-dark);
  font-size: 13px;
  font-weight: 400;
  line-height: 1.35;
}
.chapter-nav a::before {
  content: "";
  flex: none;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: transparent;
}
.chapter-nav a[aria-current="location"] { color: var(--color-text-on-dark); }
.chapter-nav a[aria-current="location"]::before { background: var(--color-accent-signal); }
.service-list a:hover,
.chapter-nav a:hover {
  color: var(--color-text-on-dark);
}
.rail-foot {
  flex: none;
  display: grid;
  justify-items: start;
  gap: 16px;
  margin-top: auto;
  padding-top: var(--spacing-6);
}
.rail-contact {
  display: inline-flex;
  align-items: center;
  padding: var(--spacing-3) var(--spacing-4);
  border-radius: var(--radius-control);
  background: var(--color-surface-paper);
  color: var(--color-text-on-paper);
  font-size: 15px;
  font-weight: 500;
  line-height: 1;
}
.rail-contact:hover {
  color: var(--color-text-on-paper);
  background: var(--color-cream-01);
}
.rail-credentials {
  display: grid;
  gap: 0.18rem;
  margin: 0;
  max-width: 28ch;
  color: var(--color-text-muted-dark);
  font-size: var(--text-caption);
  line-height: var(--text-caption--line-height);
}
.service-right { min-width: 0; }
.mobile-service-menu { display: none; }
a:focus-visible,
summary:focus-visible {
  outline: 2px solid var(--color-accent-signal);
  outline-offset: 4px;
}
:global([data-chapter-group]) { scroll-margin-top: 1.5rem; }
@media (max-width: 1023px) {
  .service-frame { grid-template-columns: minmax(0, 1fr); }
  .service-rail { display: none; }
  .mobile-service-menu {
    display: block;
    position: sticky;
    top: 0;
    z-index: 30;
    padding: 0.9rem 1.15rem;
    background: var(--color-surface-forest);
    border-bottom: 1px solid rgb(241 240 235 / 12%);
    font-family: var(--font-body);
  }
  .mobile-service-menu[open] { max-height: 85svh; overflow-y: auto; }
  .mobile-service-menu nav { margin-top: 1rem; }
  .mobile-service-menu summary { cursor: pointer; font-size: 0.875rem; }
  :global([data-chapter-group]) { scroll-margin-top: 4rem; }
}
</style>
