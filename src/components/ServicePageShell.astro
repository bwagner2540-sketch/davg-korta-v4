---
interface Chapter {
  id: string;
  label: string;
}
interface Props {
  currentPath: string;
  chapters?: Chapter[];
  headerOffset?: string;
}
const { currentPath, chapters = [], headerOffset = '0px' } = Astro.props;
const services = [
  ['Home Intelligence', '/solutions/home-intelligence/'],
  ['Architectural Lighting', '/solutions/architectural-lighting/'],
  ['Motorized Shading', '/solutions/motorized-shades/'],
  ['Media & Audio', '/solutions/media-audio/'],
  ['Private Cinemas', '/solutions/private-cinemas/'],
  ['Security Cameras & Access Control', '/solutions/security-access/'],
  ['Digital Infrastructure & Privacy', '/solutions/infrastructure-privacy/'],
  ['Outdoor Entertainment', '/solutions/outdoor-entertainment/'],
];
---
<a class="skip-link" href="#service-content">Skip to content</a>
<div class="service-frame" style={`--header-offset: ${headerOffset}`}>
  <aside class="service-rail" aria-label="Service navigation">
    <div class="brand">
      <slot name="brand">
        <a href="/">Denver AV Group</a>
      </slot>
    </div>
    <p class="rail-label">Solutions</p>
    <nav aria-label="Solutions">
      {services.map(([label, href]) => (
        <a href={href} aria-current={currentPath === href ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
    {chapters.length > 0 && (
      <nav class="chapter-nav" aria-label="On this page">
        <p class="rail-label">On this page</p>
        {chapters.map(({ id, label }) => (
          <a href={`#${id}`} data-chapter={id}>{label}</a>
        ))}
      </nav>
    )}
    <a class="rail-contact" href="#inquiry">Begin a project</a>
  </aside>
  <div class="service-right">
    <details class="mobile-service-menu">
      <summary>Solutions and page chapters</summary>
      <nav aria-label="Mobile solutions">
        {services.map(([label, href]) => (
          <a href={href} aria-current={currentPath === href ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      {chapters.length > 0 && (
        <nav aria-label="Mobile page chapters">
          {chapters.map(({ id, label }) => (
            <a href={`#${id}`} data-chapter={id}>{label}</a>
          ))}
        </nav>
      )}
      <a class="rail-contact" href="#inquiry">Begin a project</a>
    </details>
    <main id="service-content" tabindex="-1">
      <slot />
    </main>
  </div>
</div>
<script>
  const frame = document.querySelector('.service-frame');
  if (frame) {
    const menu = frame.querySelector('.mobile-service-menu');
    menu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        if (menu instanceof HTMLDetailsElement) menu.open = false;
      });
    });

    const sections = [...frame.querySelectorAll('main section[id]')];
    const setCurrent = (chapterId: string) => {
      frame.querySelectorAll('[data-chapter]').forEach((link) => {
        if (chapterId && link.getAttribute('data-chapter') === chapterId) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };
    if (sections.length && 'IntersectionObserver' in window) {
      const visible = new Map<string, number>();
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          visible.set(entry.target.id, entry.isIntersecting ? entry.intersectionRatio : 0);
        });
        const active = [...visible.entries()].sort((a, b) => b[1] - a[1])[0];
        const section = active ? frame.querySelector(`#${CSS.escape(active[0])}`) : null;
        const railId = section?.getAttribute('data-rail') || section?.id || '';
        if (active && active[1] > 0) setCurrent(railId);
      }, { rootMargin: '-15% 0px -55% 0px', threshold: [0, 0.25, 0.5] });
      sections.forEach((section) => observer.observe(section));
    }
  }
</script>
<style>
  .service-frame {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    background: var(--color-surface-ink);
    color: var(--color-text-on-dark);
    min-height: 100svh;
  }
  .service-rail {
    position: sticky;
    top: var(--header-offset);
    align-self: start;
    display: flex;
    flex-direction: column;
    height: calc(100svh - var(--header-offset));
    overflow-y: auto;
    padding: clamp(1.25rem, 2vw, 2.5rem) clamp(1rem, 1.6vw, 2rem);
    border-right: 1px solid var(--color-border-dark);
    background: var(--color-surface-forest);
  }
  .service-right {
    min-width: 0;
    background: var(--color-surface-ink);
  }
  .brand {
    margin-bottom: 2.5rem;
  }
  .brand :global(a) {
    color: inherit;
    text-decoration: none;
  }
  .brand :global(.brand-lockup) {
    display: grid;
    gap: 0.35rem;
  }
  .brand :global(.brand-name) {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--color-text-on-dark);
  }
  .brand :global(.brand-est) {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-text-quiet-dark);
  }
  .rail-label {
    margin: 0 0 0.75rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-text-quiet-dark);
  }
  nav {
    display: grid;
    gap: 0.65rem;
  }
  nav a,
  .rail-contact {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: 0.01em;
    color: var(--color-text-muted-dark);
    text-decoration: none;
  }
  nav a[aria-current="page"],
  nav a[aria-current="true"] {
    color: var(--color-text-on-dark);
    box-shadow: inset 2px 0 0 var(--color-accent-signal);
    padding-left: 0.65rem;
  }
  nav a:hover {
    color: var(--color-text-on-dark);
  }
  .chapter-nav {
    margin-block: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border-dark);
  }
  .rail-contact {
    display: inline-flex;
    width: fit-content;
    margin-top: 1.5rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-control);
    color: var(--color-text-on-dark);
  }
  .rail-contact:hover {
    border-color: var(--color-accent-signal);
  }
  .mobile-service-menu {
    display: none;
  }
  .skip-link {
    position: fixed;
    inset: 0.5rem auto auto 0.5rem;
    transform: translateY(-200%);
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--color-surface-paper);
    color: var(--color-text-on-paper);
    font-family: var(--font-body);
  }
  .skip-link:focus {
    transform: translateY(0);
  }
  :global(.service-frame section[id]) {
    scroll-margin-top: calc(var(--header-offset) + 4.5rem);
  }
  :global(.service-frame a:focus-visible),
  summary:focus-visible {
    outline: 2px solid var(--color-accent-signal);
    outline-offset: 4px;
  }
  @media (max-width: 1023px) {
    .service-frame {
      grid-template-columns: minmax(0, 1fr);
    }
    .service-rail {
      display: none;
    }
    .mobile-service-menu {
      display: block;
      position: sticky;
      top: 0;
      z-index: 30;
      padding: 1rem 1.25rem 1.1rem;
      border-bottom: 1px solid var(--color-border-dark);
      background: var(--color-surface-forest);
      font-family: var(--font-body);
    }
    .mobile-service-menu nav {
      margin-top: 1.25rem;
    }
    .mobile-service-menu nav + nav {
      margin-top: 1.5rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--color-border-dark);
    }
    summary {
      cursor: pointer;
      font-size: 0.875rem;
      font-weight: 500;
    }
  }
</style>
