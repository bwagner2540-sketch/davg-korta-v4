---
import { primaryNavigation, utilityBar } from '../config/navigation';

const path = Astro.url.pathname;
const inMenu = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header class="site-header">
  <div class="site-utility">
    <p>{utilityBar.place} <span aria-hidden="true">|</span> {utilityBar.established}</p>
    <a href={utilityBar.phoneHref}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3.5h3.2l1.2 3.1-1.8 1.1a12.5 12.5 0 0 0 6.7 6.7l1.1-1.8 3.1 1.2V17a2.5 2.5 0 0 1-2.7 2.5A15.5 15.5 0 0 1 4.5 6.2 2.5 2.5 0 0 1 7 3.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
      {utilityBar.phoneDisplay}
    </a>
  </div>
  <nav class="site-bar" aria-label="Primary" data-site-nav>
    {primaryNavigation.slice(0, 2).map((menu) => (
      <div class="site-slot">
        <div class="site-menu" data-menu>
          <button type="button" aria-expanded="false" aria-controls={`menu-${menu.id}`} class:list={{ 'is-current': menu.items.some((item) => inMenu(item.href)) }}>
            {menu.label}
          </button>
          <div id={`menu-${menu.id}`} class="site-dropdown" hidden>
            {menu.items.map((item) => (
              <a href={item.href} aria-current={inMenu(item.href) ? 'page' : undefined}>{item.label}</a>
            ))}
          </div>
        </div>
      </div>
    ))}
    <a class="site-logo" href="/">
      <img src="/brand/davg-lockup-on-black.png" alt="DAVG, Denver AV Group" width="1024" height="384" />
    </a>
    {primaryNavigation.slice(2).map((menu) => (
      <div class="site-slot">
        <div class="site-menu" data-menu>
          <button type="button" aria-expanded="false" aria-controls={`menu-${menu.id}`} class:list={{ 'is-current': menu.items.some((item) => inMenu(item.href)) }}>
            {menu.label}
          </button>
          <div id={`menu-${menu.id}`} class="site-dropdown" hidden>
            {menu.items.map((item) => (
              <a href={item.href} aria-current={inMenu(item.href) ? 'page' : undefined}>{item.label}</a>
            ))}
          </div>
        </div>
      </div>
    ))}
    <button class="site-toggle" type="button" aria-expanded="false" aria-controls="site-mobile">Menu</button>
  </nav>
  <div id="site-mobile" class="site-mobile" hidden>
    {primaryNavigation.map((menu) => (
      <div>
        <p>{menu.label}</p>
        <ul>
          {menu.items.map((item) => (
            <li><a href={item.href} aria-current={inMenu(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('[data-site-nav]')?.closest('.site-header');
  if (header) {
    const closeAll = () => {
      header.querySelectorAll<HTMLElement>('[data-menu]').forEach((menu) => {
        menu.classList.remove('is-open');
        menu.querySelector('button')?.setAttribute('aria-expanded', 'false');
        const panel = menu.querySelector<HTMLElement>('.site-dropdown');
        if (panel) panel.hidden = true;
      });
    };
    header.querySelectorAll<HTMLElement>('[data-menu]').forEach((menu) => {
      const button = menu.querySelector('button');
      const panel = menu.querySelector<HTMLElement>('.site-dropdown');
      const open = (value: boolean) => {
        if (value) closeAll();
        menu.classList.toggle('is-open', value);
        button?.setAttribute('aria-expanded', value ? 'true' : 'false');
        if (panel) panel.hidden = !value;
      };
      button?.addEventListener('click', () => open(!menu.classList.contains('is-open')));
      menu.addEventListener('mouseenter', () => { if (window.matchMedia('(min-width: 960px)').matches) open(true); });
      menu.addEventListener('mouseleave', () => { if (window.matchMedia('(min-width: 960px)').matches) open(false); });
      menu.addEventListener('focusin', () => open(true));
      menu.addEventListener('focusout', (event) => {
        if (!menu.contains(event.relatedTarget as Node)) open(false);
      });
    });
    const toggle = header.querySelector<HTMLButtonElement>('.site-toggle');
    const mobile = header.querySelector<HTMLElement>('#site-mobile');
    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (mobile) mobile.hidden = !open;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeAll();
    });
  }
</script>
<style>
.site-header { position: relative; z-index: 40; background: var(--color-surface-ink); color: var(--color-text-on-dark); }
.site-utility {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  min-height: 1.85rem;
  padding: 0.35rem 1.15rem;
  background: var(--color-accent-signal);
  color: var(--color-text-on-dark);
  font-family: var(--font-body);
  font-size: var(--text-label);
  font-weight: 500;
  letter-spacing: var(--text-label--letter-spacing);
  text-transform: uppercase;
}
.site-utility p { margin: 0; }
.site-utility a {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  color: inherit;
  text-decoration: none;
}
.site-utility svg { width: 0.85rem; height: 0.85rem; }
.site-bar {
  display: grid;
  grid-template-columns: 1fr 1fr auto 1fr 1fr;
  align-items: stretch;
  min-height: 4.7rem;
  border-bottom: 1px solid var(--color-border-dark);
}
.site-slot { display: flex; justify-content: center; min-width: 0; }
.site-menu { position: relative; display: flex; align-items: center; }
.site-menu > button,
.site-toggle {
  border: 0;
  background: transparent;
  color: var(--color-text-on-dark);
  font-family: var(--font-body);
  font-size: var(--text-label);
  font-weight: 500;
  letter-spacing: var(--text-label--letter-spacing);
  text-transform: uppercase;
  cursor: pointer;
}
.site-menu > button.is-current,
.site-menu.is-open > button,
.site-menu > button[aria-expanded="true"] { color: var(--color-accent-signal); }
.site-logo { display: flex; align-items: center; padding: 0.85rem 1.5rem; }
.site-logo img { display: block; width: 8.6rem; height: auto; }
.site-dropdown {
  position: absolute;
  top: 100%;
  left: 50%;
  z-index: 50;
  display: grid;
  min-width: 14.5rem;
  transform: translateX(-50%);
  padding: 0.85rem 0;
  background: var(--color-cream-01);
  color: var(--color-text-on-paper);
}
.site-dropdown[hidden] { display: none; }
.site-dropdown a {
  padding: 0.48rem 1.15rem;
  color: inherit;
  font-family: var(--font-body);
  font-size: var(--text-label);
  font-weight: 500;
  letter-spacing: var(--text-label--letter-spacing);
  text-transform: uppercase;
  text-decoration: none;
  white-space: nowrap;
}
.site-dropdown a:hover,
.site-dropdown a[aria-current="page"] { color: var(--color-accent-signal); }
.site-toggle { display: none; justify-self: end; margin-right: 1rem; }
.site-mobile {
  display: grid;
  gap: 1.25rem;
  padding: 1rem 1.25rem 1.5rem;
  background: var(--color-surface-ink);
  border-bottom: 1px solid var(--color-border-dark);
}
.site-mobile[hidden] { display: none; }
.site-mobile p {
  margin: 0 0 var(--spacing-2);
  color: var(--color-accent-signal);
  font-family: var(--font-body);
  font-size: var(--text-label);
  font-weight: 500;
  letter-spacing: var(--text-label--letter-spacing);
  text-transform: uppercase;
}
.site-mobile ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
.site-mobile a { color: var(--color-text-on-dark); text-decoration: none; font-family: var(--font-body); font-size: 1rem; line-height: var(--text-body--line-height); }
.site-header :focus-visible { outline: 2px solid var(--color-accent-signal); outline-offset: 3px; }
@media (max-width: 959px) {
  .site-bar { grid-template-columns: 1fr auto auto; min-height: 4rem; }
  .site-slot, .site-dropdown { display: none; }
  .site-toggle { display: inline-flex; align-items: center; }
}
</style>
