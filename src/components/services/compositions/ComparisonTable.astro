---
interface Props {
  title: string;
  table: { headers: string[]; rows: string[][] };
}
const { title, table } = Astro.props;
---
<div class="table-scroll" tabindex="0" role="region" aria-label={`${title} comparison`}>
  <table>
    <caption>{title}</caption>
    <thead>
      <tr>{table.headers.map((header) => <th scope="col">{header}</th>)}</tr>
    </thead>
    <tbody>
      {table.rows.map((row) => (
        <tr>
          {row.map((cell, index) => (index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
