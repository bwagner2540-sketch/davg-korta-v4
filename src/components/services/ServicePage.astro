---
import type { CollectionEntry } from 'astro:content';
import MediaPlaceholder from '../MediaPlaceholder.astro';
import InquiryForm from '../InquiryForm.astro';
import ServicePageShell from '../ServicePageShell.astro';
import { chapterNavigation } from '../../config/site';
import Chapter from './Chapter.astro';
import ProjectPaths from './compositions/ProjectPaths.astro';
import ScopeFrames from './compositions/ScopeFrames.astro';
import ScopeLedger from './compositions/ScopeLedger.astro';
import AnswerFrame from '../library/AnswerFrame.astro';
import ComparisonSplit from '../library/ComparisonSplit.astro';
import HoverCardCta from '../library/HoverCardCta.astro';

interface Props {
  service: CollectionEntry<'services'>['data'];
}
const { service } = Astro.props;
const chapters = new Map(service.chapters.map((chapter) => [chapter.id, chapter]));
const costDrivers = service.faqs.find((item) => item.question.toLowerCase().includes('cost'))?.answer
  ?? 'Opening size and count, fabrics, dual layers, power, mounting details, access, keypads and integration work.';
---
<script is:inline>
  document.documentElement.classList.add('js');
</script>
<a class="skip-link" href="#service-content">Skip to content</a>
<article class="service-page" id="service-content" tabindex="-1" data-service={service.slug} data-design-sandbox={service.slug}>
  <header class="service-hero split-feature" id="daylight" data-frame="hero" data-opening-section="hero" data-surface-role="hero">
    <div class="split-copy">
      {service.spatialWords.opening && <p class="service-spatial" aria-hidden="true">{service.spatialWords.opening}</p>}
      <p class="section-kicker">{service.name}</p>
      <h1>{service.hero.heading}</h1>
      <p class="deck">{service.hero.deck}</p>
      <ul class="split-points">
        <li>
          <p class="point-index">01</p>
          <p class="point-title">The window</p>
          <p>Orientation, size, frame depth and how the room is used.</p>
        </li>
        <li>
          <p class="point-index">02</p>
          <p class="point-title">The fabric</p>
          <p>View, privacy or darkness. Edges and mounting still decide the room.</p>
        </li>
        <li>
          <p class="point-index">03</p>
          <p class="point-title">The control</p>
          <p>Local, lighting scenes, or the house system — verified before it is specified.</p>
        </li>
      </ul>
      <p class="actions"><a class="btn btn-paper" href={service.hero.ctaHref}>{service.hero.ctaLabel}</a></p>
    </div>
    <div class="split-stage">
      <p class="stage-label">Architectural living</p>
      <figure class="hero-figure">
        <MediaPlaceholder
          id="shading-01-room"
          subject="Glass-wall shading photograph"
          ratio="16 / 10"
          loading="eager"
          src="/images/davg-living-room-sheer-roller-shades-sun-01-1600w.webp"
          alt="Floor-to-ceiling sheer roller shades on a living-room glass wall, with the sun still visible through the fabric"
        />
        <figcaption>
          <span><strong>Living room glass</strong> Sheer roller shades. Product photograph.</span>
          <span class="stage-tag">Illustration</span>
        </figcaption>
      </figure>
      <p class="stage-note">The same living room and a bedroom return in the decisions below. Product photograph, not a completed DAVG project.</p>
    </div>
  </header>

  <section class="service-opening philosophy-band" id="opening-question" data-frame="opening-qa" data-opening-section="answer" data-surface-role="answer" aria-labelledby="opening-question-title">
    <div class="philosophy-index">
      <p class="section-kicker">Definition</p>
      <p>A shade decision starts with the glass, not the motor.</p>
    </div>
    <div class="philosophy-main">
      <h2 id="opening-question-title">{service.openingQA.question}</h2>
      <div class="philosophy-columns">
        {service.openingQA.answer.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <ServicePageShell currentPath={`/systems/${service.slug}/`} chapters={chapterNavigation}>
      {service.groups.map((group) => (
        <section
          class="service-group"
          id={group.id}
          data-group={group.id}
          data-chapter-group
          aria-labelledby={`${group.id}-title`}
          data-surface-role={group.id === 'design' ? undefined : group.id === 'systems' ? 'systems' : group.id === 'investment' ? 'investment' : 'editorial'}
        >
          <h2 class="group-label" id={`${group.id}-title`}>{group.label}</h2>
          {group.id === 'design' && <ScopeFrames />}
          {group.id === 'design' && (
            <ComparisonSplit
              studySlot="motorized-shades-05"
              kicker="Comparison"
              heading="View-through fabric vs."
              emphasis="darkness."
              left={{
                eyebrow: 'Daylight',
                title: 'Keep the view. Control the glare.',
                body: 'A solar fabric filters daylight while preserving some view. Night privacy is a separate check, because a bright room can read through the weave.',
                image: '/images/davg-living-room-sheer-roller-shades-sun-01-1600w.webp',
                alt: 'Floor-to-ceiling sheer roller shades on a living-room glass wall, with the sun still visible through the fabric',
              }}
              right={{
                eyebrow: 'Darkness',
                title: 'Close the room. Mind the edges.',
                body: 'A blackout fabric blocks light through the material. Light can still enter at the edges unless the mounting addresses those gaps.',
                image: '/images/davg-triathlon-bedroom-shades-closed-01-800w.webp',
                alt: 'Bedroom with two white Triathlon shades fully closed across a wide window',
              }}
            />
          )}
          {group.id === 'installation' && (
            <>
              <span id="installed" class="alias"></span>
              <span id="proof" class="alias"></span>
            </>
          )}
          {group.chapterIds.map((id) => {
            const chapter = chapters.get(id);
            return chapter && (
              <Chapter chapter={chapter} study={chapter.id === 'coordination' ? service.signatureStudy : undefined} />
            );
          })}
          {group.id === 'installation' && <ProjectPaths paths={service.projectPaths} />}
          {group.id === 'investment' && <ScopeLedger scopes={service.scopeOptions} costDrivers={costDrivers} />}
        </section>
      ))}
  </ServicePageShell>

  <section class="service-questions question-list" id="questions" data-frame="questions" data-closing-section="questions" data-surface-role="questions" aria-labelledby="questions-title">
    <span id="windows" class="alias"></span>
    <div class="question-intro">
      <p class="section-kicker">Questions</p>
      <h2 id="questions-title">Denver glass, and the questions that arrive late.</h2>
      <p>West light, tall openings, finished homes and long runs between rooms change the shade decision earlier than many owners expect. Fabric, mounting and power belong in the same conversation.</p>
    </div>
    <div class="question-items">
      {service.faqs.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <AnswerFrame answer={item.answer} />
        </details>
      ))}
    </div>
  </section>

  <section class="service-inquiry" id="project-inquiry" data-frame="inquiry" data-closing-section="inquiry" data-surface-role="inquiry" aria-labelledby="inquiry-title">
    <span id="inquiry" class="alias"></span>
    <div class="inquiry-cta">
      <p class="section-kicker">Next</p>
      <h2 id="inquiry-title">{service.inquiry.heading}</h2>
      <p>{service.inquiry.body}</p>
      <HoverCardCta
        cards={[
          {
            kicker: 'Existing home',
            title: 'Survey the openings',
            note: 'Battery, wiring, and the finished room.',
            href: '#project-inquiry',
            stage: 'retrofit',
            image: '/images/davg-bedroom-motorized-shades-01-1600w.webp',
            alt: 'Bedroom with motorized roller shades at a window',
          },
          {
            kicker: 'Remodel',
            title: 'Build the mounting in',
            note: 'Blocking, power, and access while the work is open.',
            href: '#project-inquiry',
            stage: 'remodel',
            image: '/images/davg-triathlon-fascia-boucle-01-800w.webp',
            alt: 'White Triathlon fascia box mounted on shiplap above a light woven shade',
          },
          {
            kicker: 'Custom build',
            title: 'Detail every opening',
            note: 'A shade schedule before the ceiling closes.',
            href: '#project-inquiry',
            stage: 'custom-build',
            image: '/images/davg-recessed-shade-study-01.jpg',
            alt: 'Conceptual detail study of a recessed dual roller in a ceiling pocket',
          },
        ]}
      />
      <InquiryForm service={service.name} serviceSlug={service.slug} />
    </div>
  </section>
</article>
<style is:global>
.service-page {
  --sticky-offset: 0px;
  background: var(--color-surface-ink);
  color: var(--color-text-on-dark);
  font-family: var(--font-body);
}

.service-page :where(h1, h2, h3, h4) {
  margin: 0;
  color: inherit;
  font-weight: 400;
}

.service-page h1 {
  max-width: 18ch;
  font-size: var(--text-h1);
  letter-spacing: -0.035em;
}

.service-page h2 {
  font-size: var(--text-h2);
}

.service-page h3 {
  max-width: 24ch;
  margin-top: 0.25rem;
  font-size: var(--text-h3);
}

.service-page h4 {
  font-size: 1.25rem;
}

.service-page :where(p, li, ul, ol, h1, h2, h3, h4, figure, figcaption) {
  margin: 0;
}

.service-page a {
  color: inherit;
}

.service-page figure {
  margin: 0;
}

.service-page figcaption {
  margin-top: var(--spacing-3);
  max-width: 70ch;
  font-size: var(--text-caption);
  line-height: 1.4;
  color: var(--surface-muted, var(--color-text-muted-dark));
}

.skip-link {
  position: fixed;
  inset: 0.5rem auto auto 0.5rem;
  z-index: 100;
  transform: translateY(-200%);
  padding: 0.75rem 1rem;
  background: var(--color-surface-paper);
  color: var(--color-text-on-paper);
  font-family: var(--font-body);
}

.skip-link:focus {
  transform: translateY(0);
}

.alias {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  scroll-margin-top: var(--spacing-6);
}

.service-masthead,
.service-hero,
.service-opening,
.service-questions,
.service-inquiry {
  padding: var(--spacing-section) var(--spacing-page-inline);
}

.service-masthead {
  display: flex;
  align-items: center;
  padding-block: 1.25rem;
  border-bottom: 1px solid var(--color-border-dark);
}

.brand-lockup {
  display: grid;
  gap: 0.35rem;
  color: inherit;
  text-decoration: none;
}

.brand-name {
  font-family: var(--font-mono);
  font-size: 0.8125rem;
  font-weight: 500;
  letter-spacing: 0.14em;
}

.brand-est {
  font-size: 0.75rem;
  color: var(--color-text-quiet-dark);
}

.service-hero,
.service-inquiry,
.composition-ink {
  background: var(--color-surface-ink);
  color: var(--color-text-on-dark);
}

.service-hero {
  position: relative;
  display: grid;
  gap: 2rem;
  overflow: hidden;
}

.service-hero-copy,
.hero-figure,
.study-copy,
.composition > :not(.service-spatial) {
  position: relative;
  z-index: 1;
}

.kicker,
.group-label,
.study-lead {
  margin: 0 0 1rem;
  font-family: var(--font-body);
  font-size: 0.875rem;
  font-weight: 500;
  letter-spacing: 0.04em;
  color: var(--surface-muted, var(--color-text-muted-dark));
}

.group-label {
  font-size: 0.75rem;
  text-transform: uppercase;
}

.deck {
  max-width: 62ch;
  font-size: 1.125rem;
}

.actions {
  margin-top: 1.5rem;
}

.btn {
  display: inline-flex;
  width: fit-content;
  padding: 0.8rem 1rem;
  border: 1px solid var(--color-border-dark);
  border-radius: var(--radius-control);
  background: transparent;
  color: inherit;
  font: 500 0.875rem/1.2 var(--font-body);
  text-decoration: none;
  cursor: pointer;
}

.btn:hover {
  border-color: var(--color-accent-signal);
}

.path-recognition {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem 1.25rem;
  margin-top: 1.5rem;
  font-size: 0.875rem;
}

.path-recognition span {
  color: var(--color-text-quiet-dark);
}

.service-spatial {
  position: absolute;
  bottom: -0.12em;
  left: -0.04em;
  z-index: 0;
  margin: 0;
  pointer-events: none;
  font-family: var(--font-display);
  font-size: clamp(5.5rem, 16vw, 15rem);
  font-weight: 300;
  line-height: 0.8;
  letter-spacing: -0.045em;
  color: var(--color-spatial-dark);
  user-select: none;
}

.service-opening,
.service-questions,
.composition-paper {
  background: var(--color-surface-paper);
  color: var(--color-text-on-paper);
}

.service-opening .kicker,
.composition-paper figcaption,
.service-questions figcaption {
  color: var(--color-text-muted-paper);
}

.service-measure {
  max-width: 75ch;
}

.service-middle {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
  align-items: start;
  background: var(--color-surface-forest);
}

.service-rail {
  position: sticky;
  top: var(--sticky-offset);
  align-self: start;
  padding: 2rem var(--spacing-page-inline) 3rem;
  background: var(--color-surface-forest);
  color: var(--color-text-on-dark);
}

.service-rail-name {
  margin: 0;
  font-family: var(--font-display);
  font-size: 1.75rem;
  font-weight: 300;
  line-height: 1.1;
}

.service-rail ol {
  display: grid;
  gap: 0.35rem;
  margin: 1.5rem 0 0;
  padding: 0;
  list-style: none;
}

.service-rail a {
  display: block;
  padding: 0.7rem 0;
  color: var(--color-text-muted-dark);
  font-size: 0.875rem;
  font-weight: 500;
  text-decoration: none;
}

.service-rail a[aria-current='location'] {
  color: var(--color-text-on-dark);
  box-shadow: inset 2px 0 0 var(--color-accent-signal);
  padding-left: 0.65rem;
}

.service-reading-field {
  min-width: 0;
  background: var(--color-surface-ink);
}

.service-group {
  position: relative;
  scroll-margin-top: 1.25rem;
  padding: 0;
}

.composition {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: var(--spacing-8);
  padding: var(--spacing-section) var(--spacing-page-inline);
}

.composition > h3 {
  max-width: 820px;
  font-size: var(--text-h2);
  line-height: var(--text-h2--line-height);
  letter-spacing: var(--text-h2--letter-spacing);
}

.composition:not(.tier-columns) > p {
  max-width: 70ch;
  font-size: var(--text-body);
  line-height: 1.6;
  text-wrap: pretty;
}

.composition:not(.tier-columns) > p:first-of-type {
  font-size: var(--text-body-lg);
}

.composition-study {
  overflow: hidden;
  margin-inline: calc(var(--spacing-page-inline) * -1);
  padding: clamp(2rem, 4vw, 4rem) var(--spacing-page-inline);
  background: linear-gradient(145deg, var(--color-surface-forest) 0%, var(--color-surface-ink) 72%);
  color: var(--color-text-on-dark);
}

.composition-paper {
  background: var(--color-surface-paper);
  color: var(--color-text-on-paper);
}

.opening-strip,
.keypad-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.75rem 1rem;
  margin-top: 1.5rem;
}

.keypad-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.study-grid,
.media-split,
.scene-layout,
.path-layout {
  display: grid;
  grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
  gap: 1.5rem 2rem;
  align-items: start;
  margin-top: 1.5rem;
}

.tabset.is-enhanced [role='tabpanel'][hidden] {
  display: none !important;
}

.family-images,
.scene-images {
  display: grid;
  gap: 1rem;
}

.tabset-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem 1.5rem;
  align-items: end;
  justify-content: space-between;
  margin-top: 1.5rem;
}

.tabset-bar [role='tablist'] {
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem 1.25rem;
}

.tabset-bar [role='tab'],
.tabset-bar [data-show-all] {
  padding: 0.35rem 0 0.55rem;
  border: 0;
  border-bottom: 1px solid transparent;
  background: transparent;
  color: inherit;
  font: 500 1rem/1.3 var(--font-body);
  cursor: pointer;
}

.tabset-bar [role='tab'][aria-selected='true'] {
  border-bottom-color: var(--color-accent-signal);
}

.tabset-bar [data-show-all] {
  font-size: 0.8125rem;
  color: var(--surface-muted, var(--color-text-muted-dark));
}

.tab-panel ul {
  padding-left: 1.1rem;
}

.ledger,
.scope-ledger {
  display: grid;
  gap: 0;
  margin-top: 1.5rem;
}

.ledger div,
.scope-ledger article {
  padding: 1rem 0;
  border-top: 1px solid var(--surface-border, var(--color-border-dark));
}

.composition-paper .ledger div,
.composition-paper .scope-ledger article,
.service-questions details {
  border-top-color: var(--color-border-paper);
}

.ledger dt,
.scope-ledger h4 {
  margin: 0 0 0.35rem;
  font-family: var(--font-body);
  font-size: 0.875rem;
  font-weight: 500;
}

.ledger dd {
  margin: 0;
}

.scope-ledger {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.5rem;
}

.scope-ledger article {
  border-top: 1px solid var(--color-border-paper);
}

.ledger-note,
.dual-layer {
  margin-top: 1rem;
}

.table-scroll {
  overflow-x: auto;
  margin-top: 1.5rem;
}

.service-page table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.9375rem;
}

.service-page caption {
  padding-block: 0.75rem;
  text-align: left;
  font-size: 0.8125rem;
}

.service-page th,
.service-page td {
  padding: 0.9rem 0.75rem;
  border-bottom: 1px solid var(--surface-border, var(--color-border-dark));
  font-weight: 400;
  text-align: left;
  vertical-align: top;
}

.composition-paper th,
.composition-paper td,
.service-questions details {
  border-bottom-color: var(--color-border-paper);
}

.service-questions details {
  border-bottom: 1px solid var(--color-border-paper);
  padding-block: 1.1rem;
}

.service-questions summary {
  cursor: pointer;
  font-size: 1.0625rem;
}

.contact-routes {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem 1.5rem;
}

.form-note,
.form-status {
  max-width: 62ch;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem;
  margin-top: 1.5rem;
}

.inquiry label {
  display: grid;
  gap: 0.4rem;
  margin-top: 1rem;
  font-size: 0.875rem;
}

.inquiry input,
.inquiry textarea,
.inquiry select {
  width: 100%;
  padding: 0.75rem 0.8rem;
  border: 1px solid var(--color-border-dark);
  border-radius: var(--radius-control);
  background: transparent;
  color: inherit;
  font: inherit;
}

.inquiry input[readonly] {
  color: var(--color-text-muted-dark);
}

.service-page :where(a, button, summary, input, textarea, select):focus-visible {
  outline: 2px solid var(--color-accent-signal);
  outline-offset: 3px;
}

@media (max-width: 1100px) {
  .study-grid,
  .media-split,
  .scene-layout,
  .path-layout,
  .opening-strip,
  .keypad-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 1023px) {
  .service-middle {
    display: block;
  }

  .service-rail {
    position: static;
    padding-block: 1.25rem;
  }

  .service-rail ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    margin-top: 0.75rem;
  }

  .service-rail-name {
    font-size: 1.5rem;
  }

  .scope-ledger,
  .form-grid {
    grid-template-columns: 1fr;
  }
}

.service-page h2.group-label {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}

.split-feature {
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
  gap: 0;
  padding: 0;
}
.split-copy {
  position: relative;
  overflow: hidden;
  padding: var(--spacing-section) var(--spacing-page-inline);
}
.split-copy .service-spatial { color: var(--surface-spatial, var(--color-spatial-dark)); }
.split-copy h1 { max-width: 16ch; font-size: var(--text-h1); }
.split-points { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--spacing-6); margin: var(--spacing-8) 0 0; padding: var(--spacing-6) 0 0; list-style: none; border-top: 1px solid var(--surface-border, var(--color-border-dark)); }
.split-points li { display: grid; gap: var(--spacing-2); }
.split-points p { margin: 0; max-width: 28ch; font-size: 0.9375rem; line-height: var(--text-body--line-height); }
.point-index { color: var(--color-accent-signal); font-family: var(--font-mono); font-size: var(--text-mono); letter-spacing: var(--text-mono--letter-spacing); line-height: var(--text-mono--line-height); text-transform: uppercase; }
.point-title { color: inherit; font-family: var(--font-body); font-size: 1rem; font-weight: 500; letter-spacing: 0; text-transform: none; }
.split-stage { display: grid; align-content: end; gap: var(--spacing-4); padding: var(--spacing-6); background: var(--color-surface-ink); color: var(--color-text-on-dark); }
.stage-label, .stage-tag { font-family: var(--font-mono); font-size: var(--text-mono); letter-spacing: var(--text-mono--letter-spacing); line-height: var(--text-mono--line-height); text-transform: uppercase; color: var(--color-accent-signal); }
.hero-figure { position: relative; }
.hero-figure figcaption { position: absolute; left: var(--spacing-4); right: var(--spacing-4); bottom: var(--spacing-4); display: flex; justify-content: space-between; gap: var(--spacing-4); margin: 0; padding: var(--spacing-3) var(--spacing-4); background: var(--color-scrim-ink-strong); color: var(--color-text-on-dark); }
