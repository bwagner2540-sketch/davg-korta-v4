---
interface Props { slotId: string; kicker: string; heading: string; lede: string; word: string; }
const { slotId, kicker, heading, lede, word } = Astro.props;
---
<section class="folio architectural-background-section" id={slotId} data-study-slot={slotId} data-study-built="true" data-surface-role="signature-study" data-signature-study="true" aria-labelledby={`${slotId}-title`}>
  <p class="architectural-background-title" data-surface="juniper" aria-hidden="true">{word}</p>
  <div class="folio-copy section-content">
    <p class="section-kicker">{kicker}</p>
    <h3 id={`${slotId}-title`}>{heading}</h3>
    <p>{lede}</p>
  </div>
  <div class="folio-visual section-visual">
    <slot />
  </div>
</section>
<style>
.folio {
  display: grid;
  gap: var(--spacing-component);
  max-width: none;
  margin: var(--spacing-component) 0 0;
  padding: var(--spacing-component);
  overflow: hidden;
  background: linear-gradient(145deg, var(--color-surface-forest) 0%, var(--color-surface-ink) 72%);
  color: var(--color-text-on-dark);
  --surface-fg: var(--color-text-on-dark);
  --surface-muted: var(--color-text-secondary-dark);
  --surface-border: var(--color-border-dark);
}
.folio-copy { display: grid; gap: 0.85rem; max-width: var(--measure-body); }
.folio h3 {
  max-width: 16ch;
  font-size: var(--text-h3);
  line-height: var(--text-h3--line-height);
  letter-spacing: var(--text-h3--letter-spacing);
  font-weight: 400;
}
.folio-copy p { max-width: 46ch; line-height: 1.5; color: var(--surface-muted); }
.folio-visual { min-width: 0; }
</style>
