---
interface Props { slotId: string; kicker: string; heading: string; lede: string; }
const { slotId, kicker, heading, lede } = Astro.props;
---
<section class="neutral-study" id={slotId} data-study-slot={slotId} data-study-built="true" data-surface-role="editorial" aria-labelledby={`${slotId}-title`}>
  <p class="section-kicker">{kicker}</p>
  <h3 id={`${slotId}-title`}>{heading}</h3>
  <p class="neutral-lede">{lede}</p>
  <div class="neutral-visual"><slot /></div>
</section>
<style>
.neutral-study {
  display: grid;
  gap: 0.9rem;
  margin-top: var(--spacing-component);
  padding: var(--spacing-component);
  border: 1px solid var(--color-border-paper);
  background: var(--color-surface-paper);
  color: var(--color-text-on-paper);
  --surface-fg: var(--color-text-on-paper);
  --surface-muted: var(--color-text-secondary-paper);
  --surface-border: var(--color-border-paper);
}
.neutral-study h3 {
  max-width: 22ch;
  font-size: var(--text-h3);
  line-height: var(--text-h3--line-height);
  letter-spacing: var(--text-h3--letter-spacing);
  font-weight: 400;
  color: var(--color-text-on-paper);
}
.neutral-lede { max-width: 62ch; line-height: 1.55; color: var(--color-text-muted-paper); }
.neutral-visual { min-width: 0; }
.neutral-visual :global(svg) { display: block; width: 100%; height: auto; }
</style>
