---
/** Good / Better / Best tier set. Three unboxed hairline columns. Prices only when supplied — never invented. */
import type { GbbSet } from '../../data/gbb';
interface Props extends GbbSet { tone?: 'dark' | 'paper' }
const { title, model, tiers, tone = 'dark' } = Astro.props;
const p = tone === 'paper';
const rule = p ? 'border-line-paper' : 'border-line-dark';
const fg = p ? 'text-on-paper' : 'text-on-dark';
const mute = p ? 'text-muted-paper' : 'text-muted-dark';
const quiet = p ? 'text-muted-paper' : 'text-quiet-dark';
const names = ['Good', 'Better', 'Best'];
---
<div class="flex flex-col gap-5">
  {(title || model) && (
    <div class="flex flex-wrap items-baseline justify-between gap-6">
      {title && <div class:list={['font-display text-h5', fg]}>{title}</div>}
      {model && <div class:list={['mono-label', quiet]}>{model}</div>}
    </div>
  )}
  <div class:list={['grid border-y md:grid-cols-3', rule]}>
    {tiers.map((t, i) => (
      <div class:list={['group relative flex flex-col gap-2.5 py-6 md:px-6 md:first:pl-0', i > 0 && ['border-t md:border-t-0 md:border-l', rule]]}>
        <span class="absolute inset-x-0 -top-px h-px bg-transparent transition-colors duration-150 group-hover:bg-signal"></span>
        <div class:list={['mono-label flex items-center gap-2.5', fg]}>
          <span class="size-1 rounded-full bg-signal" style={`opacity:${0.4 + i * 0.3}`}></span>{t.tier ?? names[i]}
        </div>
        {t.label && <div class:list={['text-caption', mute]}>{t.label}</div>}
        <div class:list={['font-display text-h6', fg]}>{t.name}</div>
        {t.body && <p class:list={['m-0 text-caption leading-normal text-pretty', mute]}>{t.body}</p>}
        <div class="mt-auto flex flex-col gap-1.5 pt-2.5">
          {t.detail && <div class:list={['text-xs leading-snug', quiet]}>{t.detail}</div>}
          {t.from && <div class="flex items-baseline gap-2"><span class:list={['mono-label', quiet]}>Starting from</span><span class:list={['font-mono text-sm', fg]}>{t.from}</span></div>}
        </div>
      </div>
    ))}
  </div>
</div>
