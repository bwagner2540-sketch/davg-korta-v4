---
import { services } from '../config/site';
---
<nav class="service-links" aria-label="Services">
  <ol>
    {services.map((service) => (
      <li><a href={service.href}>{service.railLabel}</a></li>
    ))}
  </ol>
</nav>
<style>
.service-links ol {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 0.45rem;
}
.service-links a {
  color: inherit;
  font-family: var(--font-body);
  font-size: 0.9375rem;
  line-height: 1.4;
  text-decoration: none;
}
.service-links a:hover { color: var(--color-accent-signal); }
</style>
