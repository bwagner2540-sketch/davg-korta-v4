---
/** Renders one planned hub section (hero, chapter, case-study reservation, inquiry). Used by the service route in all three page zones. */
import SplitHero from './SplitHero.astro';
import Chapter from './Chapter.astro';
import InquiryForm from './InquiryForm.astro';
import Blocks from '../content/Blocks.astro';
import GoodBetterBest from '../content/GoodBetterBest.astro';
import MediaSlot from '../ui/MediaSlot.astro';
import Heading from '../ui/Heading.astro';
import { SERVICES } from '../../data/services';
import { site } from '../../config/site';
interface Props { x: any; hub: any; media: Record<string, { src: string; alt: string }> }
const { x, hub, media } = Astro.props;
const s = x.s;
const t = x.tone === 'paper' ? 'paper' : 'dark';
const showProof = site.showProofPreview || import.meta.env.DEV;
---
{x.kind === 'hero' && (
  <SplitHero id={s.id} eyebrow={hub.eyebrow} title={s.meta.headline || hub.h1} deck={s.meta.deck} word={hub.word} variant={site.heroVariant} cta={{ label: 'Begin a project', href: '#s15' }}
    primary={s.meta.cta ? { label: s.meta.cta, href: '#s15' } : undefined}
    media={{ slotId: `${hub.slug}-01`, src: media['01']?.src, alt: media['01']?.alt }} />
)}
{x.kind === 'inquiry' && (
  <section id={s.id} data-screen-label="15 Inquiry" class="flex scroll-mt-16 flex-col gap-12 bg-paper px-page py-section">
    {s.blocks.filter((b: any) => b.type === 'p').map((b: any) => <p class="m-0 max-w-measure text-body leading-[1.6] text-muted-paper" set:html={b.html} />)}
    <div class="flex flex-col gap-6 border-t border-line-paper pt-12">
      <Heading level={2} tone="paper">{s.meta.final_headline || s.title}</Heading>
      {s.meta.support_line && <p class="m-0 max-w-measure text-body-lg text-muted-paper">{s.meta.support_line}</p>}
    </div>
    <InquiryForm services={SERVICES.map((v) => v.name)} service={hub.name} submitLabel={s.meta.cta || 'Send project brief'} briefFields={[
      { id: 'stage', label: 'Project stage', type: 'select', options: ['New construction', 'Renovation', 'Finished home', 'System takeover'] },
      { id: 'area', label: 'Community', type: 'select', options: [...site.territory, 'Elsewhere in Colorado'] },
      { id: 'notes', label: 'What should we know?', type: 'textarea' },
    ]} />
  </section>
)}
{x.kind === 'proof' && (showProof ? (
  <section id={s.id} data-screen-label={`${s.nn} Case study (preview)`} class="flex scroll-mt-16 flex-col gap-6 border-t border-dashed border-line-dark bg-ink px-page py-section lg:scroll-mt-0">
    <div class="mono-label text-quiet-dark">Case study · preview only, hidden publicly until a verified project is assigned</div>
    <Heading level={3}>{s.title}</Heading>
    <div class="grid gap-4 md:grid-cols-[2fr_1fr]">
      <MediaSlot slotId={`${hub.slug}-${s.nn}a`} subject="Project — wide architectural view" ratio="16 / 9" />
      <MediaSlot slotId={`${hub.slug}-${s.nn}b`} subject="Project — hardware / finish detail" ratio="4 / 5" />
    </div>
  </section>
) : <div id={s.id}></div>)}
{x.kind === 'chapter' && (
  <Chapter id={s.id} title={s.title} tone={x.tone} group={x.group} word={x.word} label={`${s.nn} ${s.title}`}>
    {x.slots.length > 0 && (
      <figure class="m-0 flex flex-col gap-3">
        <div class:list={['grid gap-4', x.slots.length > 1 && 'sm:grid-cols-2']}>
          {x.slots.map((m: any) => <MediaSlot {...m} tone={t} />)}
        </div>
        {s.meta.caption && <figcaption class:list={['text-caption', t === 'paper' ? 'text-muted-paper' : 'text-muted-dark']}>{s.meta.caption}</figcaption>}
      </figure>
    )}
    {x.gbb.length > 0 && <div class="flex flex-col gap-12">{x.gbb.map((set: any) => <GoodBetterBest {...set} tone={t} />)}</div>}
    <Blocks blocks={s.blocks} tone={t} />
  </Chapter>
)}
