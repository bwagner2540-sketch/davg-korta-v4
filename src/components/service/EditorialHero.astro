---
/** Service opener inside the 75% field: headline, deck, one primary action, broad media slot. */
import Heading from '../ui/Heading.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import TextLink from '../ui/TextLink.astro';
import MediaSlot from '../ui/MediaSlot.astro';
interface Props {
  id?: string; eyebrow?: string; title: string; deck?: string;
  primary?: { label: string; href: string }; secondary?: { label: string; href: string };
  media: { slotId: string; src?: string; alt?: string; subject?: string; ratio?: string };
}
const { id, eyebrow, title, deck, primary, secondary, media } = Astro.props;
---
<section id={id} data-screen-label="01 Hero" class="scroll-mt-16 bg-ink px-page pt-section lg:scroll-mt-0">
  <div class="flex max-w-headline flex-col">
    {eyebrow && <Eyebrow class="mb-6">{eyebrow}</Eyebrow>}
    <Heading level={1}>{title}</Heading>
    {deck && <p class="mt-6 mb-0 max-w-measure text-body-lg text-muted-dark text-pretty">{deck}</p>}
    {(primary || secondary) && (
      <div class="mt-8 flex flex-wrap items-center gap-7">
        {primary && <Button href={primary.href}>{primary.label}</Button>}
        {secondary && <TextLink href={secondary.href}>{secondary.label}</TextLink>}
      </div>
    )}
  </div>
  <MediaSlot {...media} eager class="mt-12" />
</section>
