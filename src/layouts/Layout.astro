---
import '../styles/global.css';
interface Props {
  title?: string;
}
const { title = "Denver AV Group" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-surface-ink text-text-primary-dark antialiased">
    <slot />
  </body>
</html>
