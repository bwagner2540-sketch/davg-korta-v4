    <section id="systems" class="architectural-background-section scroll-mt-20 bg-forest">
      <h2 class="architectural-background-title" data-surface="juniper" aria-hidden="true">Intelligence</h2>

      <div class="section-content folio py-24 md:py-32">
        <div class="grid grid-cols-12 gap-6 border-b border-[rgb(241_240_235/0.10)] pb-8 lg:gap-8">
          <p class="col-span-12 font-mono text-[11px] font-medium uppercase tracking-[0.16em] text-dark-3 lg:col-span-5">02 / System specification</p>
          <p class="col-span-12 font-mono text-[11px] tracking-[0.12em] text-dark-3 lg:col-span-7 lg:text-right">HomeWorks QSX · Control4 OS 3 · Front Range</p>
