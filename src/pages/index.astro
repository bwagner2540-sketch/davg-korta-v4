<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DAVG — Architectural AV and Home Intelligence, Colorado</title>
  <meta name="description" content="DAVG is a residential integration firm designing architectural AV, lighting, shade, and home intelligence across South Metro Denver. Lutron Certified HomeWorks Integrator. Control4 Platinum Dealer. CEDIA Member. Since 2013." />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500;600&family=Schibsted+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            ink: "#090B0A",
            forest: "#183B31",
            paper: "#EDE9E0",
            cream: { 1: "#F2EFE7", 2: "#EBE7DC", 3: "#E2DDCE" },
            signal: "#1A8F6E",
            "dark-1": "#F1F0EB",
            "dark-2": "#A7AAA5",
            "dark-3": "#7F847E",
            "paper-1": "#0B0D0C",
            "paper-2": "#51544F",
          },
          fontFamily: {
            display: ['"Schibsted Grotesk"', "sans-serif"],
            body: ['"Instrument Sans"', "sans-serif"],
            mono: ['"JetBrains Mono"', "ui-monospace", "monospace"],
          },
          maxWidth: { folio: "1440px" },
        },
      },
    };
  </script>

  <style>
    :root {
      --color-surface-ink: #090B0A;
      --color-surface-forest: #183B31;
      --color-surface-paper: #EDE9E0;
      --color-text-primary-dark: #F1F0EB;
      --color-text-secondary-dark: #A7AAA5;
      --color-text-tertiary-dark: #7F847E;
      --color-text-primary-paper: #0B0D0C;
      --color-text-secondary-paper: #51544F;
      --color-accent-signal: #1A8F6E;
      --color-border-dark: rgb(241 240 235 / 18%);
      --color-border-dark-soft: rgb(241 240 235 / 10%);
      --color-border-paper: rgb(11 13 12 / 16%);
      --color-rule-accent: rgb(26 143 110 / 78%);
      --color-scrim-ink-soft: rgb(9 11 10 / 38%);
      --color-scrim-ink-strong: rgb(9 11 10 / 66%);
      --color-spatial-word-dark: rgb(241 240 235 / 12%);
      --color-spatial-word-forest: rgb(241 240 235 / 14%);
      --font-display: "Schibsted Grotesk";
      --font-body: "Instrument Sans";
      --font-mono: "JetBrains Mono";
    }

    * { box-sizing: border-box; }

    html, body {
      background: var(--color-surface-ink);
      color: var(--color-text-primary-dark);
      font-family: var(--font-body), sans-serif;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      max-width: 100%;
      overflow-x: hidden;
    }

    h1, h2, h3, p, li, dd, dt {
      overflow-wrap: break-word;
    }

    ::selection {
      background: rgb(26 143 110 / 28%);
      color: var(--color-text-primary-dark);
    }

    .folio {
      width: 100%;
      max-width: 1440px;
      margin-left: auto;
      margin-right: auto;
      padding-left: 24px;
      padding-right: 24px;
      min-width: 0;
    }

    @media (min-width: 768px) {
      .folio { padding-left: 48px; padding-right: 48px; }
    }

    @media (min-width: 1280px) {
      .folio { padding-left: 64px; padding-right: 64px; }
    }

    .architectural-background-section {
      position: relative;
      overflow: hidden;
    }

    .architectural-background-section > .section-content,
    .architectural-background-section > .section-visual,
    .architectural-background-section > .section-annotations {
      position: relative;
      z-index: 2;
    }

    .architectural-background-title {
      position: absolute;
      top: 4.5%;
      left: -2%;
      z-index: 0;
      pointer-events: none;
      font-family: var(--font-display), sans-serif;
      font-size: clamp(12rem, 16vw, 17.25rem);
      font-weight: 300;
      line-height: 0.78;
      letter-spacing: -0.045em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .architectural-background-title[data-surface="ink"] {
      color: var(--color-spatial-word-dark);
      -webkit-text-fill-color: currentColor;
      background: none;
    }

    .architectural-background-title[data-surface="juniper"] {
      color: var(--color-spatial-word-forest);
      -webkit-text-fill-color: currentColor;
      background: none;
    }

    .architectural-background-title[data-surface="cream"] {
      background: linear-gradient(
        90deg,
        rgba(91, 108, 99, 0.42) 0%,
        rgba(124, 130, 119, 0.34) 30%,
        rgba(151, 150, 136, 0.28) 58%,
        rgba(193, 184, 163, 0.22) 82%,
        rgba(226, 216, 195, 0.16) 100%
      );
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
    }

    .hero-spatial {
      top: auto;
      bottom: -6%;
      left: -3%;
    }

    @media (max-width: 1024px) {
      .architectural-background-title {
        font-size: clamp(9rem, 17vw, 13rem);
        letter-spacing: -0.05em;
      }
    }

    @media (max-width: 640px) {
      .architectural-background-title {
        font-size: clamp(6.5rem, 29vw, 10rem);
        font-weight: 300;
        line-height: 0.78;
        letter-spacing: -0.055em;
      }
    }

    .spec-row {
      display: grid;
      grid-template-columns: minmax(0, 0.42fr) minmax(0, 0.58fr);
      gap: 16px;
      padding: 16px 0;
      border-bottom: 1px solid var(--color-border-dark-soft);
    }

    @media (max-width: 640px) {
      .spec-row {
        grid-template-columns: 1fr;
        gap: 8px;
        padding: 14px 0;
      }
    }

    .annotation-node {
      width: 4px;
      height: 4px;
      border-radius: 0;
      background: var(--color-accent-signal);
      box-shadow: 0 0 0 1px rgb(9 11 10 / 40%);
    }

    .keypad-plate {
      width: 100%;
      max-width: 280px;
      aspect-ratio: 3 / 4.2;
      background: #1a1d1b;
      border: 1px solid rgb(241 240 235 / 12%);
      padding: 28px 22px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .keypad-btn {
      width: 44px;
      height: 44px;
      border: 1px solid rgb(241 240 235 / 16%);
      background: #121513;
    }

    .keypad-btn.is-active {
      border-color: rgb(26 143 110 / 78%);
    }

    #mobile-nav { display: none; }
    #nav-toggle:checked ~ #mobile-nav { display: block; }
    @media (min-width: 1024px) {
      #mobile-nav { display: none !important; }
    }

    a:focus-visible,
    button:focus-visible,
    summary:focus-visible {
      outline: 1px solid var(--color-accent-signal);
      outline-offset: 3px;
    }
  </style>
</head>
