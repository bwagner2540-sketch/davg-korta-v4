---
import Layout from '../layouts/Layout.astro';
import TopNav from '../components/nav/TopNav.astro';
import GoodBetterBest from '../components/content/GoodBetterBest.astro';

const navLinks = [
  { label: 'Answer', href: '#answer' },
  { label: 'Systems', href: '#systems' },
  { label: 'Proof', href: '#proof' },
  { label: 'Scope', href: '#scope' },
  { label: 'Trade', href: '#trade' },
  { label: 'Inquiry', href: '#inquiry' },
];

const scopeTiers = [
  {
    tier: 'Good',
    label: 'Focused openings',
    name: 'Room-level',
    body: 'A single volume that has to perform: screening room, primary suite, or great room.',
    detail: 'Includes standalone lighting or shade, dedicated acoustics. Solves one room, one standard, no whole-home scene graph.',
  },
  {
    tier: 'Better',
    label: 'Whole-home scenes',
    name: 'Home-level',
    body: 'The residence operates as one system: lighting, shade, audio, and control on a shared processor.',
    detail: 'Includes HomeWorks / Control4, distributed audio, network core. Solves fragmented apps and rooms that do not share scenes.',
  },
  {
    tier: 'Best',
    label: 'Specified with the architecture',
    name: 'Estate-level',
    body: 'Zero-compromise coordination from schematic through occupancy, including cinema and concealed infrastructure.',
    detail: 'Includes pocket details, rack core, Ketra, stewardship after occupancy. Right for new construction and major renovations.',
  },
];
---
<Layout title="DAVG — Architectural AV and Home Intelligence, Colorado" description="DAVG is a residential integration firm designing architectural AV, lighting, shade, and home intelligence across South Metro Denver. Lutron Certified HomeWorks Integrator. Control4 Platinum Dealer. CEDIA Member. Since 2013.">
  <a href="#answer" class="sr-only focus:not-sr-only focus:absolute focus:left-6 focus:top-6 focus:z-50 focus:bg-paper focus:px-4 focus:py-2 focus:text-on-paper">Skip to content</a>
  <TopNav links={navLinks} cta={{ label: 'Begin a project', href: '#inquiry' }} tone="dark" />

  <style>
    .folio {
      width: 100%;
      max-width: 1440px;
      margin-inline: auto;
      padding-inline: var(--spacing-page);
      min-width: 0;
    }
    .spec-row {
      display: grid;
      grid-template-columns: minmax(0, 0.42fr) minmax(0, 0.58fr);
      gap: var(--spacing-4);
      padding: var(--spacing-4) 0;
      border-bottom: 1px solid var(--color-line-dark-soft);
    }
    .bg-paper .spec-row,
    .bg-paper .spec-row {
      border-bottom-color: var(--color-line-paper);
    }
    @media (max-width: 640px) {
      .spec-row {
        grid-template-columns: 1fr;
        gap: var(--spacing-2);
        padding: 14px 0;
      }
    }
    .annotation-node {
      width: var(--size-node);
      height: var(--size-node);
      border-radius: 0;
      background: var(--color-signal);
    }
    .keypad-plate {
      width: 100%;
      max-width: 280px;
      aspect-ratio: 3 / 4.2;
      background: var(--color-ink);
      border: 1px solid var(--color-line-dark);
      padding: var(--spacing-6) var(--spacing-5);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .keypad-btn {
      width: 44px;
      height: 44px;
      border: 1px solid var(--color-line-dark);
      background: var(--color-ink);
    }
    .keypad-btn.is-active {
      border-color: var(--color-rule-accent);
    }
    a:focus-visible,
    button:focus-visible,
    summary:focus-visible {
      outline: 1px solid var(--color-signal);
      outline-offset: 3px;
    }
  </style>

<main class="pt-20">
    <!-- Phase 1 — Definitive Answer -->
    <section id="answer" class="architectural-background-section relative overflow-hidden scroll-mt-20 bg-paper pt-24 text-on-paper md:pt-32">
      <h2 class="architectural-background-title" data-surface="cream" aria-hidden="true">Clearance</h2>
      <div class="section-content folio py-24 md:py-32">
        <p class="font-mono text-mono font-medium uppercase tracking-widest text-muted-paper">01 / Direct answer</p>
        <h1 class="mt-8 max-w-measure font-display text-h2 font-normal leading-none tracking-tight">
          Pocket depth is a dimension, not a finish.
        </h1>
        <p class="mt-8 max-w-measure text-body leading-normal text-muted-paper">
          What’s the pocket depth for motorized Lutron Palladiom shades behind a floor-to-ceiling window wall?
        </p>
        <p class="mt-6 max-w-measure text-body-lg font-medium leading-normal text-on-paper">
          Typical pocket depth for motorized Lutron Palladiom shades behind a floor-to-ceiling window wall is 5.5–7.5 inches, with low-voltage clearance reserved in the head condition before drywall. Undersize either dimension and the fabric roll binds against trim within a season.
        </p>
        <p class="mt-6 max-w-measure text-body leading-normal text-muted-paper">
          DAVG is a residential integration firm — Lutron Certified HomeWorks Integrator, Control4 Platinum Dealer, 2026 CEDIA Member — designing architectural AV, lighting, shade, and home intelligence across South Metro Denver: Cherry Hills Village, Castle Pines, Greenwood Village, Littleton, Centennial, and Lone Tree. Operating since 2013.
        </p>
        <dl class="mt-16 max-w-3xl border-t border-line-paper">
          <div class="spec-row grid-cols-1 border-line-paper sm:grid-cols-2">
            <dt class="font-mono text-mono font-medium uppercase tracking-wider text-muted-paper">Palladiom pocket</dt>
            <dd class="text-caption leading-snug text-on-paper sm:text-right">5.5–7.5 in typical</dd>
          </div>
          <div class="spec-row grid-cols-1 border-line-paper sm:grid-cols-2">
            <dt class="font-mono text-mono font-medium uppercase tracking-wider text-muted-paper">Low-voltage clearance</dt>
            <dd class="text-caption leading-snug text-on-paper sm:text-right">Reserved in the head condition, pre-drywall</dd>
          </div>
          <div class="spec-row grid-cols-1 border-b-0 border-line-paper sm:grid-cols-2">
            <dt class="font-mono text-mono font-medium uppercase tracking-wider text-muted-paper">Credentials</dt>
            <dd class="text-caption leading-snug text-on-paper sm:text-right">HomeWorks Integrator · Control4 Platinum · CEDIA 2026</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- Phase 2 — Category Authority -->
    <section id="systems" class="architectural-background-section relative overflow-hidden scroll-mt-20 bg-paper text-on-paper">
      <h2 class="architectural-background-title" data-surface="cream" aria-hidden="true">Intelligence</h2>
      <div class="section-content folio py-24 md:py-32">
        <div class="grid grid-cols-12 gap-6 border-b border-line-paper pb-8 lg:gap-8">
          <p class="col-span-12 font-mono text-mono font-medium uppercase tracking-widest text-muted-paper lg:col-span-5">02 / Category authority</p>
          <p class="col-span-12 font-mono text-mono tracking-wider text-muted-paper lg:col-span-7 lg:text-right">HomeWorks QSX · Control4 OS 3 · 0.8–10 Nm</p>
        </div>
        <div class="mt-16 grid grid-cols-12 gap-12 lg:mt-20 lg:gap-20">
          <div class="col-span-12 min-w-0 lg:col-span-5">
            <h2 class="font-display text-h2 font-normal leading-tight tracking-tight text-on-paper">
              A motorized shade is a system, not a kit.
            </h2>
            <p class="mt-8 max-w-measure text-body leading-normal text-muted-paper">
              Fabric, tubular motor, control protocol, and a power path have to size together. A big-box smart blind is a self-contained unit. Architectural shade work is fabric selection, then motor and tube sizing, then a Lutron HomeWorks QSX processor talking to Control4 or standing alone, then the invisible layer: low-voltage wiring and a pocket or valance that conceals the roll.
            </p>
            <p class="mt-6 max-w-measure text-body leading-normal text-muted-paper">
              Lighting follows the same distinction. Ketra is tunable-white architectural light. It is not a smart LED bulb. The processor topology is the operating layer both systems share.
            </p>
          </div>
          <div class="col-span-12 min-w-0 lg:col-span-7">
            <div class="border-t border-line-paper" role="table" aria-label="Technical specification ledger">
              <div class="spec-row" role="row">
                <span class="font-mono text-mono font-medium uppercase tracking-wider text-muted-paper" role="cell">Processor</span>
                <span class="text-caption leading-snug text-on-paper" role="cell">Lutron HomeWorks QSX</span>
              </div>
              <div class="spec-row" role="row">
                <span class="font-mono text-mono font-medium uppercase tracking-wider text-muted-paper" role="cell">Control layer</span>
                <span class="text-caption leading-snug text-on-paper" role="cell">Control4 OS 3</span>
              </div>
              <div class="spec-row" role="row">
                <span class="font-mono text-mono font-medium uppercase tracking-wider text-muted-paper" role="cell">Shade drive</span>
                <span class="text-caption leading-snug text-on-paper" role="cell">Quiet tubular motor, 0.8–10 Nm</span>
              </div>
              <div class="spec-row" role="row">
                <span class="font-mono text-mono font-medium uppercase tracking-wider text-muted-paper" role="cell">Pocket clearance</span>
                <span class="text-caption leading-snug text-on-paper" role="cell">5.5–7.5 in typical Palladiom</span>
              </div>
              <div class="spec-row" role="row">
                <span class="font-mono text-mono font-medium uppercase tracking-wider text-muted-paper" role="cell">Integration bus</span>
                <span class="text-caption leading-snug text-on-paper" role="cell">QS Link · IP</span>
              </div>
              <div class="spec-row border-b-0" role="row">
                <span class="font-mono text-mono font-medium uppercase tracking-wider text-muted-paper" role="cell">Lighting</span>
                <span class="text-caption leading-snug text-on-paper" role="cell">Ketra / HomeWorks QS</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Phase 3 — Tactile & Sensory Proof / Forest study -->
    <section id="proof" class="architectural-background-section relative min-h-screen overflow-hidden scroll-mt-20 bg-forest pt-16 md:pt-20">
      <div class="absolute inset-0 z-0 overflow-hidden">
        <img
          src="/images/davg-living-room-lutron-shades-orlando-01-1600w.webp"
          alt="Living room with recessed Lutron shades"
          class="h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-scrim-ink-strong"></div>
      </div>
      <h2 class="architectural-background-title hero-spatial" data-surface="juniper" aria-hidden="true">Residence</h2>
      <div class="section-annotations pointer-events-none absolute inset-0 z-[2] hidden lg:block">
        <div class="folio relative h-full">
          <div class="absolute right-0 top-1/3 flex w-60 flex-col gap-10">
            <div class="flex items-start gap-3">
              <span class="annotation-node mt-1.5 block shrink-0"></span>
              <span class="mt-2 h-px w-10 shrink-0 bg-line-dark"></span>
              <div>
                <p class="font-mono text-mono font-medium uppercase tracking-widest text-on-dark">Daylight</p>
                <p class="mt-1 font-mono text-mono leading-snug tracking-wider text-quiet-dark">South glass. Harvested, not fought.</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="annotation-node mt-1.5 block shrink-0"></span>
              <span class="mt-2 h-px w-10 shrink-0 bg-line-dark"></span>
              <div>
                <p class="font-mono text-mono font-medium uppercase tracking-widest text-on-dark">Shade pocket</p>
                <p class="mt-1 font-mono text-mono leading-snug tracking-wider text-quiet-dark">Recessed head. 0–2px site radii.</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="annotation-node mt-1.5 block shrink-0"></span>
              <span class="mt-2 h-px w-10 shrink-0 bg-line-dark"></span>
              <div>
                <p class="font-mono text-mono font-medium uppercase tracking-widest text-on-dark">Quiet drive</p>
                <p class="mt-1 font-mono text-mono leading-snug tracking-wider text-quiet-dark">Tubular motor, not a box-store hum.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="section-content folio relative flex min-h-[calc(100vh-5rem)] flex-col justify-between py-16 md:py-20">
        <div class="grid grid-cols-12 gap-6 lg:gap-8">
          <div class="col-span-12 min-w-0 lg:col-span-5">
            <p class="font-mono text-mono font-medium uppercase tracking-widest text-quiet-dark">03 / Tactile proof</p>
            <h2 class="mt-8 font-display text-h2 font-normal leading-tight tracking-tight text-on-dark">
              6:15 AM, three inches of light, no one else wakes.
            </h2>
            <p class="mt-8 max-w-measure text-body leading-normal text-muted-dark">
              Primary bedroom shades rise a few inches to let in light without waking the room next door, then fully open at the scene set for actual wake time. The motor is quiet tubular drive — 0.8–10 Nm — not the rattle of a retail kit against the headrail.
            </p>
          </div>
        </div>
        <figure class="relative mt-16 max-w-xl overflow-hidden md:ml-auto">
          <img
            src="/images/davg-bedroom-motorized-shades-01-1600w.webp"
            alt="Primary bedroom with motorized architectural shades"
            class="w-full object-cover"
          />
        </figure>
      </div>
    </section>

    <!-- Phase 4 — Tiered Scope / Investment Framing -->
    <section id="scope" class="architectural-background-section relative overflow-hidden scroll-mt-20 border-t border-line-dark bg-ink">
      <h2 class="architectural-background-title" data-surface="ink" aria-hidden="true">Scope</h2>
      <div class="section-content folio py-section">
        <div class="mb-16 flex flex-col gap-8">
          <p class="mono-label text-muted-dark">04 / Engineering Scope</p>
          <h2 class="font-display text-h2 text-on-dark">
            Three scopes. The difference is engineering, not a menu.
          </h2>
        </div>
        <GoodBetterBest
          title="Engineering scope"
          model="Scope / Experience tier"
          tone="dark"
          tiers={scopeTiers}
          note="The difference is engineering depth and coordination — not a packaged menu. Installed prices are scoped per residence."
        />
      </div>
    </section>

    <!-- Phase 5 — Trade & Engineering Validation -->
    <section id="trade" class="architectural-background-section relative overflow-hidden scroll-mt-20 bg-forest">
      <h2 class="architectural-background-title" data-surface="ink" aria-hidden="true">Recessed</h2>
      <div class="section-content folio py-24 md:py-32">
        <div class="grid grid-cols-12 gap-12 lg:gap-20">
          <div class="col-span-12 min-w-0 lg:col-span-5">
            <p class="font-mono text-mono font-medium uppercase tracking-widest text-quiet-dark">05 / Trade validation</p>
            <h2 class="mt-8 font-display text-h2 font-normal leading-tight tracking-tight text-on-dark">
              The same pocket detail we hand to framers.
            </h2>
            <p class="mt-8 max-w-measure text-body leading-normal text-muted-dark">
              This is a pre-construction coordination resource, not a finished-room photograph. Pocket and valance details, low-voltage rough-in, and the rack path from HomeWorks QSX into Control4 are specified before drywall. Lutron Certified HomeWorks Integrator status is the credential attached to that processor claim. Control4 Platinum Dealer status is the credential attached to the control-layer claim.
            </p>
          </div>
          <div class="section-visual col-span-12 min-w-0 lg:col-span-7">
            <figure class="relative overflow-hidden">
              <img
                src="/images/davg-bedroom-shade-fascia-detail-01-800w.webp"
                alt="Recessed shade fascia and pocket detail for pre-construction coordination"
                class="w-full object-cover"
              />
            </figure>
            <ul class="mt-10 border-t border-line-dark">
              <li class="flex items-baseline justify-between gap-4 border-b border-line-dark-soft py-4">
                <span class="font-mono text-mono tracking-wider text-quiet-dark">01</span>
                <span class="flex-1 text-caption text-on-dark">Rack / utility core</span>
              </li>
              <li class="flex items-baseline justify-between gap-4 border-b border-line-dark-soft py-4">
                <span class="font-mono text-mono tracking-wider text-quiet-dark">02</span>
                <span class="flex-1 text-caption text-on-dark">HomeWorks QSX processor</span>
              </li>
              <li class="flex items-baseline justify-between gap-4 border-b border-line-dark-soft py-4">
                <span class="font-mono text-mono tracking-wider text-quiet-dark">03</span>
                <span class="flex-1 text-caption text-on-dark">Room keypads</span>
              </li>
              <li class="flex items-baseline justify-between gap-4 py-4">
                <span class="font-mono text-mono tracking-wider text-quiet-dark">04</span>
                <span class="flex-1 text-caption text-on-dark">Shade and lighting loads</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Phase 6 — Stewardship & Conversion -->
    <section id="inquiry" class="architectural-background-section relative overflow-hidden scroll-mt-20 bg-ink">
      <h2 class="architectural-background-title" data-surface="ink" aria-hidden="true">Steward</h2>
      <div class="section-content folio py-24 md:py-32">
        <p class="font-mono text-mono font-medium uppercase tracking-widest text-quiet-dark">06 / Stewardship</p>
        <h2 class="mt-8 max-w-[16ch] font-display text-h2 font-normal leading-tight tracking-tight text-on-dark">
          The system needs a relationship, not a ticket.
        </h2>
        <p class="mt-8 max-w-[54ch] text-body leading-normal text-muted-dark">
          Firmware and processor health are monitored. Scenes are tuned seasonally. Response is priority, not a queue. Year one is commissioning and occupancy calibration. Year three is firmware, shade fabric, and scene review. Beyond that, the same operating layer is still ours to keep quiet. DAVG has done this work since 2013.
        </p>
        <p class="mt-6 max-w-[54ch] text-body leading-normal text-muted-dark">
          South Metro Denver — Cherry Hills Village, Castle Pines, Greenwood Village, Littleton, Centennial, Lone Tree.
        </p>
        <a href="mailto:info@davg.ai" class="mt-10 inline-flex items-center border border-line-dark bg-paper px-6 py-3 font-body text-mono font-medium uppercase tracking-wider text-on-paper transition-colors hover:bg-cream-01">Begin a project</a>
        <p class="mt-16 font-mono text-mono tracking-wider text-quiet-dark">Your Home, Automated by Design</p>
      </div>
    </section>
  </main>

  <footer class="border-t border-line-dark-soft bg-ink">
    <div class="folio py-8">
      <div class="grid grid-cols-2 gap-6 md:grid-cols-4 md:gap-8">
        <div>
          <p class="font-mono text-mono tracking-wider text-quiet-dark">Office</p>
          <a href="tel:7206381603" class="mt-2 block font-mono text-mono tracking-wider text-on-dark">720.638.1603</a>
        </div>
        <div>
          <p class="font-mono text-mono tracking-wider text-quiet-dark">Direct · Field</p>
          <a href="tel:7203277337" class="mt-2 block font-mono text-mono tracking-wider text-on-dark">720.327.7337</a>
        </div>
        <div>
          <p class="font-mono text-mono tracking-wider text-quiet-dark">Email</p>
          <a href="mailto:info@davg.ai" class="mt-2 block font-mono text-mono tracking-wider text-on-dark">info@davg.ai</a>
        </div>
        <div class="md:text-right">
          <p class="font-mono text-mono tracking-wider text-quiet-dark">South Metro</p>
          <p class="mt-2 font-mono text-mono tracking-wider text-on-dark">Colorado</p>
        </div>
      </div>
      <div class="mt-8 flex flex-col justify-between gap-3 border-t border-line-dark-soft pt-6 md:flex-row">
        <p class="font-mono text-mono tracking-wider text-quiet-dark">© 2026 DAVG · Formerly Denver AV Guy</p>
        <p class="font-mono text-mono tracking-wider text-quiet-dark">Lutron HomeWorks · Control4 Platinum · CEDIA 2026</p>
      </div>
    </div>
  </footer>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "LocalBusiness",
        "@id": "https://davg.ai/#business",
        "name": "DAVG",
        "alternateName": "Denver AV Guy",
        "url": "https://davg.ai",
        "foundingDate": "2013",
        "email": "info@davg.ai",
        "telephone": "+1-720-638-1603",
        "description": "DAVG is a residential integration firm — Lutron Certified HomeWorks Integrator, Control4 Platinum Dealer, 2026 CEDIA Member — designing architectural AV, lighting, shade, and home intelligence across South Metro Denver: Cherry Hills Village, Castle Pines, Greenwood Village, Littleton, Centennial, and Lone Tree. Operating since 2013.",
        "areaServed": [
          "Cherry Hills Village",
          "Castle Pines",
          "Greenwood Village",
          "Littleton",
          "Centennial",
          "Lone Tree"
        ],
        "hasCredential": [
          "Lutron Certified HomeWorks Integrator",
          "Control4 Platinum Dealer",
          "2026 CEDIA Member"
        ]
      },
      {
        "@type": "FAQPage",
        "@id": "https://davg.ai/#faq",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "What’s the pocket depth for motorized Lutron Palladiom shades behind a floor-to-ceiling window wall?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Typical pocket depth for motorized Lutron Palladiom shades behind a floor-to-ceiling window wall is 5.5–7.5 inches, with low-voltage clearance reserved in the head condition before drywall. Undersize either dimension and the fabric roll binds against trim within a season."
            }
          },
          {
            "@type": "Question",
            "name": "Who is DAVG?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "DAVG is a residential integration firm — Lutron Certified HomeWorks Integrator, Control4 Platinum Dealer, 2026 CEDIA Member — designing architectural AV, lighting, shade, and home intelligence across South Metro Denver: Cherry Hills Village, Castle Pines, Greenwood Village, Littleton, Centennial, and Lone Tree. Operating since 2013."
            }
          }
        ]
      }
    ]
  }
  </script>
  <script>
    if (location.hash) {
      document.documentElement.classList.remove("scroll-smooth");
    }
    document.querySelectorAll("#mobile-nav a").forEach((link) => {
      link.addEventListener("click", () => {
        document.getElementById("nav-toggle").checked = false;
      });
    });
  </script>


</Layout>
