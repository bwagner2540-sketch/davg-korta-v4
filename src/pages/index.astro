---
import '../styles/global.css';
import SiteIndex from '../components/SiteIndex.astro';
import inventory from '../data/page-inventory.json';

const hubs = inventory.pages.filter((page) => page.kind === 'hub');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DAVG — Architectural AV and Home Intelligence, Colorado</title>
    <meta name="description" content="DAVG is a residential integration firm designing architectural AV, lighting, shade, and home intelligence across South Metro Denver. Lutron Certified HomeWorks Integrator. Control4 Platinum Dealer. CEDIA Member. Since 2013." />
  </head>
  <body>
    <a class="skip" href="#practice">Skip to content</a>
    <div class="home-sheet">
      <aside class="home-rail">
        <a class="home-mark" href="/">DAVG</a>
        <p class="home-mark__meta">Denver AV Group · Est. 2013</p>
        <SiteIndex current="/" variant="rail" />
      </aside>

      <main class="home-field" id="practice">
        <p class="home-kicker">South Metro Denver</p>
        <h1>Your Home, Automated by Design.</h1>
        <p class="home-lead">
          DAVG is a residential integration firm designing architectural AV, lighting, shade, and home intelligence across South Metro Denver. Lutron Certified HomeWorks Integrator. Control4 Platinum Dealer. CEDIA member, 2026. Operating since 2013.
        </p>

        <nav class="home-ledger" aria-label="Eight practices">
          {hubs.map((hub, index) => (
            <a href={hub.href}>
              <span class="site-index__num">{String(index + 1).padStart(2, '0')}</span>
              <span class="home-ledger__name">{hub.label}</span>
              <span class="home-ledger__decision">{hub.decision}</span>
            </a>
          ))}
        </nav>

        <p class="home-close">
          <span>Cherry Hills Village, Castle Pines, Greenwood Village, Littleton, Centennial, Lone Tree, Parker, Castle Rock</span>
          <a href="tel:7206381603">720.638.1603</a>
          <a href="tel:7203277337">720.327.7337</a>
          <a href="mailto:info@davg.ai">info@davg.ai</a>
        </p>
      </main>
    </div>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      '@id': 'https://davg.ai/#business',
      name: 'DAVG',
      alternateName: 'Denver AV Guy',
      url: 'https://davg.ai',
      foundingDate: '2013',
      email: 'info@davg.ai',
      telephone: '+1-720-638-1603',
      description: 'DAVG is a residential integration firm designing architectural AV, lighting, shade, and home intelligence across South Metro Denver. Lutron Certified HomeWorks Integrator. Control4 Platinum Dealer. CEDIA Member. Since 2013.',
      areaServed: ['Cherry Hills Village', 'Castle Pines', 'Greenwood Village', 'Littleton', 'Centennial', 'Lone Tree', 'Parker', 'Castle Rock'],
    })} />
  </body>
</html>
