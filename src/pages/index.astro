                <span class="text-[13px] leading-[1.35] text-dark-1" role="cell">Control4 OS 3</span>
              </div>
              <div class="spec-row" role="row">
                <span class="font-mono text-[11px] font-medium uppercase tracking-[0.12em] text-dark-3" role="cell">Lighting</span>
