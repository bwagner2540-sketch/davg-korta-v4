<script>
  const stageButtons = document.querySelectorAll<HTMLButtonElement>('[data-project-stage]');
  const stageNotes = document.querySelectorAll<HTMLElement>('[data-stage]');
  const stageField = document.querySelector<HTMLSelectElement>('#project-stage');

  const setStage = (stage: string) => {
    stageButtons.forEach((button) => {
      button.setAttribute('aria-pressed', button.dataset.projectStage === stage ? 'true' : 'false');
    });
    stageNotes.forEach((note) => {
      note.classList.toggle('is-active', Boolean(stage) && note.dataset.stage === stage);
    });
    if (stageField && stageField.value !== stage) stageField.value = stage;
  };

  stageButtons.forEach((button) => {
    button.addEventListener('click', () => setStage(button.dataset.projectStage ?? ''));
  });
  stageField?.addEventListener('change', () => setStage(stageField.value));

  const sceneCopy: Record<string, string> = {
    Morning: 'Living room: raise the solar shade and let the view in. Bedroom: open enough for daylight without a separate task at the glass.',
    Afternoon: 'Living room: lower the solar shade before west glare reaches the seating. Bedroom: keep the privacy layer where dawn light or a street view requires it.',
    Evening: 'Living room: close the privacy treatment as the lights come on. Bedroom: lower the darkening layer for sleep. Proposed responses only.',
  };
  const sceneButtons = document.querySelectorAll<HTMLButtonElement>('[data-scene]');
  const sceneLabel = document.getElementById('scene-label');
  const sceneText = document.getElementById('scene-copy');
  sceneButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const scene = button.dataset.scene ?? '';
      sceneButtons.forEach((item) => item.setAttribute('aria-pressed', item === button ? 'true' : 'false'));
      if (sceneLabel) sceneLabel.textContent = scene;
      if (sceneText) sceneText.textContent = sceneCopy[scene] ?? '';
    });
  });

  const form = document.getElementById('shading-inquiry');
  const status = document.getElementById('inquiry-status');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (status) {
      status.textContent = 'Not sent. This inquiry has no delivery destination yet. Email info@davg.ai or call 720.638.1603.';
    }
  });
</script>
