---
import Layout from '../../layouts/Layout.astro';
import ServiceRail from '../../components/service/ServiceRail.astro';
import GoodBetterBest from '../../components/content/GoodBetterBest.astro';
import { site } from '../../config/site';

const services = site.services.map((s) => ({
  name: s.name,
  href: s.href,
  current: s.href === '/solutions/motorized-shades/',
}));

const chapters = [
  { id: 'daylight', label: 'Daylight' },
  { id: 'answer', label: 'The answer' },
  { id: 'solar-study', label: 'Solar study' },
  { id: 'decision', label: 'Decision' },
  { id: 'architecture', label: 'Architecture' },
  { id: 'scope', label: 'Scope' },
  { id: 'inquiry', label: 'Inquiry' },
];

const scopeTiers = [
  {
    tier: 'Good',
    label: 'Focused openings',
    name: 'Room-Level Focus',
    body: 'Targeted automation for primary spaces: master bedroom blackout shades or great room solar management.',
    detail: 'Includes Lutron wireless or hardwired shades, Pico or Palladiom keypads, local scene control. Right for single-room renovations and occupied home refreshes.',
  },
  {
    tier: 'Better',
    label: 'Whole-home coordination',
    name: 'Whole-Home Coordination',
    body: 'All primary window elevations synchronized across solar tracking, lighting scenes, and security modes.',
    detail: 'Includes HomeWorks QSX processor, hardwired low-voltage panels, full astronomical clock automation. Right for substantial residential renovations and custom builds.',
  },
  {
    tier: 'Best',
    label: 'Specified with the architecture',
    name: 'Estate-Level Architecture',
    body: 'Zero-compromise integration from schematic architectural planning through long-term concierge stewardship.',
    detail: 'Includes custom recessed dual pockets, custom architectural hembars, Ketra lighting synchronization, on-site framing templates. Right for large custom estate builds coordinated with architects and general contractors.',
  },
];
---
<Layout title="Motorized Shading — Architectural Daylight & Solar Automation | DAVG">
  <ServiceRail services={services} chapters={chapters} cta={{ label: 'Begin a project', href: '#inquiry' }}>

    <!-- CHAPTER 01 -->
    <section id="daylight" class="architectural-background-section min-h-screen flex flex-col justify-between pt-32 pb-16 px-6 md:px-16 border-b border-line-dark">
      <div class="architectural-background-title select-none" data-surface="ink">
        DAYLIGHT
      </div>
      <div class="section-content max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-end">
        <div class="lg:col-span-8">
          <div class="inline-flex items-center gap-3 mb-6">
            <span class="w-2 h-2 rounded-full bg-signal"></span>
            <span class="font-mono text-xs uppercase tracking-widest text-muted-dark">
              01 / Architectural Shading
            </span>
          </div>
          <h1 class="text-4xl md:text-6xl lg:text-7xl font-display font-light tracking-tight leading-none mb-8 text-on-dark">
            Daylight harvested, glare managed, structure preserved.
          </h1>
          <p class="text-lg md:text-xl text-muted-dark max-w-2xl font-light leading-relaxed">
            Motorized window treatments engineered into pre-construction pockets and window assemblies across South Metro Denver. Specified with the architecture, not mounted over trim after the fact.
          </p>
        </div>
        <div class="lg:col-span-4 border-l border-line-dark-soft pl-8 space-y-6">
          <div>
            <span class="block font-mono text-mono uppercase tracking-widest text-quiet-dark mb-1">Operating Protocol</span>
            <p class="text-sm font-display text-on-dark">Lutron HomeWorks QSX · Clear Connect Type X</p>
          </div>
          <div>
            <span class="block font-mono text-mono uppercase tracking-widest text-quiet-dark mb-1">Front Range Solar Profile</span>
            <p class="text-sm font-display text-on-dark">5,280' high-altitude UV mitigation & solar tracking</p>
          </div>
          <div>
            <span class="block font-mono text-mono uppercase tracking-widest text-quiet-dark mb-1">Firm Verification</span>
            <p class="text-sm font-display text-on-dark">Lutron Certified HomeWorks Integrator · Est. 2013</p>
          </div>
        </div>
      </div>
      <!-- Hero Visual Frame with Hairline Border -->
      <div class="section-visual max-w-7xl mx-auto w-full mt-12 pt-6 border-t border-line-dark-soft">
        <div class="relative w-full aspect-video overflow-hidden bg-forest">
          <img 
            src="/images/davg-living-room-lutron-shades-orlando-01-1600w.webp" 
            alt="Floor-to-ceiling glass wall with recessed Lutron motorized shades overlooking Front Range landscape"
            class="w-full h-full object-cover opacity-80"
          />
          <div class="absolute bottom-4 left-6 font-mono text-mono tracking-widest uppercase text-on-dark bg-ink/70 px-3 py-1 border border-line-dark">
            Figure 1.1 — Recessed Dual-Roller Condition · Great Room
          </div>
        </div>
      </div>
    </section>
    <!-- CHAPTER 02 -->
    <section id="answer" class="relative bg-paper text-on-paper py-28 px-6 md:px-16 border-b border-line-paper">
      <div class="max-w-6xl mx-auto">
        <span class="font-mono text-xs tracking-widest text-muted-paper uppercase block mb-4">
          02 / The Definitive Answer
        </span>
        <h2 class="text-h2 font-display font-light text-on-paper leading-tight tracking-tight max-w-4xl mb-10">
          A motorized shade is an integrated envelope system, not an aftermarket blind.
        </h2>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 border-t border-line-paper pt-10">
          <div class="lg:col-span-7 space-y-6 text-base text-muted-paper leading-relaxed">
            <p class="text-lg text-on-paper font-normal">
              Typical pocket depth for motorized Lutron Palladiom shades behind a floor-to-ceiling window wall is 5.5 to 7.5 inches, with low-voltage clearance reserved in the head condition before drywall. Undersize either dimension and the fabric roll binds against trim within a season.
            </p>
            <p>
              Motorized shading integrates four distinct layers: performance architectural fabric (openness factor and emissivity), precision tubular drives operating below conversation decibels, digital control bus architecture (Lutron QS Link or wireless Clear Connect), and continuous low-voltage power infrastructure homerun back to a central equipment core.
            </p>
            <p>
              When engineered during schematic framing, motorized window treatments eliminate visible wiring, expose zero mounting brackets, and coordinate with reflected ceiling plans to drop invisibly from flush ceiling pockets.
            </p>
          </div>
          <div class="lg:col-span-5 border-l border-line-paper pl-8 space-y-6">
            <div class="pb-6 border-b border-line-paper">
              <span class="font-mono text-xs uppercase tracking-widest text-muted-paper block mb-1">Primary Dimension</span>
              <p class="font-display text-2xl text-on-paper">5.5" – 7.5" Pocket Depth</p>
              <span class="font-mono text-mono text-muted-paper">Single or dual roller clearance</span>
            </div>
            <div class="pb-6 border-b border-line-paper">
              <span class="font-mono text-xs uppercase tracking-widest text-muted-paper block mb-1">Acoustic Floor</span>
              <p class="font-display text-2xl text-on-paper">&lt; 38 dBA Sound Level</p>
              <span class="font-mono text-mono text-muted-paper">Lutron Quiet Electronic Drive (QED)</span>
            </div>
            <div>
              <span class="font-mono text-xs uppercase tracking-widest text-muted-paper block mb-1">Wiring Standard</span>
              <p class="font-display text-2xl text-on-paper">16/2 AWG + Cat6 Low-Voltage</p>
              <span class="font-mono text-mono text-muted-paper">Homerun to central power distribution panel</span>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- CHAPTER 03 -->
    <section id="solar-study" class="architectural-background-section bg-forest text-on-dark py-28 px-6 md:px-16 border-b border-line-dark-soft">
      <div class="architectural-background-title select-none" data-surface="juniper">
        SOLAR STUDY
      </div>
      <div class="section-content max-w-7xl mx-auto">
        <div class="max-w-3xl mb-16">
          <span class="font-mono text-xs tracking-widest text-signal uppercase block mb-3">
            03 / Signature System Study
          </span>
          <h2 class="text-h2 font-display font-light leading-tight tracking-tight mb-6">
            Solar Geometry Study: Front Range Altitude & Thermal Control
          </h2>
          <p class="text-base text-muted-dark leading-relaxed">
            At 5,280 feet, ultraviolet exposure and low-angle winter solar gain degrade interiors and overheat living zones. Motorized shades operate as automated thermal baffles based on calculated solar azimuth.
          </p>
        </div>
        <!-- System Study 6-Part Crawlable HTML Ledger — ruled rows -->
        <ol class="ruled-list" data-tone="dark">
          <li><span class="ruled-num">01</span><span><strong class="text-on-dark">What You Are Evaluating.</strong> Calculated solar angles across southern and western glass exposures. Low-angle winter sun penetrates deeply into living volumes, causing severe glare, while summer sun increases air conditioning load exponentially.</span></li>
          <li><span class="ruled-num">02</span><span><strong class="text-on-dark">Why It Matters to Architecture.</strong> Automated fabric positioning preserves view lines while stopping up to 85% of solar radiation before it converts to interior heat, protecting wide-plank hardwood floors and fine art from photodegradation.</span></li>
          <li><span class="ruled-num">03</span><span><strong class="text-on-dark">What DAVG Evaluates.</strong> Fabric openness factors (1%, 3%, 5%, or blackout), internal weave reflection coefficients, bracket deflection under load, and roll-diameter clearance inside ceiling assemblies.</span></li>
          <li><span class="ruled-num">04</span><span><strong class="text-on-dark">What Commonly Goes Wrong.</strong> Undersized pockets that crush fabric hems, unbacked drywall anchors that sag under 40-pound shade assemblies, and noisy line-voltage motors that turn wake-up routines into industrial rattle.</span></li>
          <li><span class="ruled-num">05</span><span><strong class="text-on-dark">How DAVG Verifies & Delivers.</strong> Laser measurement of window frames post-drywall, CAD blocking diagrams provided to framers at framing stage, hembar tolerance verification, and astronomical clock commissioning.</span></li>
          <li><span class="ruled-num">06</span><span><strong class="text-on-dark">Related System Decision.</strong> Coordinate shade automation directly with <a href="/solutions/architectural-lighting/" class="text-on-dark underline decoration-signal underline-offset-4">Architectural Lighting</a> and <a href="/solutions/home-intelligence/" class="text-on-dark underline decoration-signal underline-offset-4">Home Intelligence</a> for unified circadian wake and evening scenes.</span></li>
        </ol>
      </div>
    </section>
    <!-- CHAPTER 04 -->
    <section id="decision" class="relative bg-paper text-on-paper py-28 px-6 md:px-16 border-b border-line-paper">
      <div class="max-w-7xl mx-auto">
        <span class="font-mono text-xs tracking-widest text-muted-paper uppercase block mb-4">
          04 / Decision Framework
        </span>
        <h2 class="text-h2 font-display font-light text-on-paper leading-tight tracking-tight max-w-3xl mb-12">
          Comparing shade architectures: hardwired vs. wireless retrofit.
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 border-t border-b border-line-paper divide-y md:divide-y-0 md:divide-x divide-[var(--color-border-paper)]">
          <div class="py-10 md:pr-12">
            <span class="font-mono text-mono uppercase tracking-widest text-muted-paper block mb-2">Architecture 01</span>
            <h3 class="text-2xl font-display font-normal text-on-paper mb-4">Hardwired Low-Voltage (Pre-Construction)</h3>
            <p class="text-sm text-muted-paper leading-relaxed mb-6">
              Low-voltage wiring pulled home to central Lutron panels. Ideal for new builds, additions, and studs-up remodels where ceiling cavities remain accessible.
            </p>
            <ul class="space-y-3 font-mono text-xs text-muted-paper">
              <li class="flex items-center gap-2"><span class="text-signal">✓</span> Zero battery maintenance forever</li>
              <li class="flex items-center gap-2"><span class="text-signal">✓</span> Supports ultra-quiet Palladiom exposed architectural brackets</li>
              <li class="flex items-center gap-2"><span class="text-signal">✓</span> Perfectly synchronized hembar alignment across multi-window spans</li>
              <li class="flex items-center gap-2"><span class="text-quiet-dark">✕</span> Requires low-voltage rough-in before insulation and drywall</li>
            </ul>
          </div>
          <div class="py-10 md:pl-12">
            <span class="font-mono text-mono uppercase tracking-widest text-muted-paper block mb-2">Architecture 02</span>
            <h3 class="text-2xl font-display font-normal text-on-paper mb-4">Battery RF Wireless (Occupied Retrofit)</h3>
            <p class="text-sm text-muted-paper leading-relaxed mb-6">
              Operates on standard D-cell alkaline batteries using Clear Connect RF. Ideal for completed homes where running new wiring through finished ceilings is cost-prohibitive.
            </p>
            <ul class="space-y-3 font-mono text-xs text-muted-paper">
              <li class="flex items-center gap-2"><span class="text-signal">✓</span> Installs without opening drywall or repainting</li>
              <li class="flex items-center gap-2"><span class="text-signal">✓</span> 3–5 year battery life under typical daily operation</li>
              <li class="flex items-center gap-2"><span class="text-signal">✓</span> Full keypad, app, and scene integration with Control4/Lutron</li>
              <li class="flex items-center gap-2"><span class="text-quiet-dark">✕</span> Limited to enclosed cassette headrails to conceal battery pack</li>
            </ul>
          </div>
        </div>
      </div>
    </section>
    <!-- CHAPTER 05 -->
    <section id="architecture" class="relative bg-ink text-on-dark py-28 px-6 md:px-16 border-b border-line-dark">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-3xl mb-16">
          <span class="font-mono text-xs tracking-widest text-signal uppercase block mb-3">
            05 / Behind The Architecture
          </span>
          <h2 class="text-h2 font-display font-light leading-tight tracking-tight mb-6">
            Structural blocking, pocket coordination, and wiring pathways.
          </h2>
          <p class="text-base text-muted-dark leading-relaxed">
            Every bracket carries the full weight and continuous operating torque of the shade. We coordinate low-voltage rough-in and structural framing before walls close.
          </p>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <div class="lg:col-span-6 space-y-4">
            <div class="p-6 border border-line-dark bg-forest/20">
              <span class="font-mono text-mono uppercase tracking-widest text-signal block mb-1">Specification 01</span>
              <h3 class="text-lg font-display text-on-dark mb-2">Structural Continuous Blocking</h3>
              <p class="text-sm text-muted-dark">Solid 2x wood blocking secured to header structure. Shades are never anchored to drywall, plaster, or hollow window jambs.</p>
            </div>
            <div class="p-6 border border-line-dark bg-forest/20">
              <span class="font-mono text-mono uppercase tracking-widest text-signal block mb-1">Specification 02</span>
              <h3 class="text-lg font-display text-on-dark mb-2">Dual Pocket Sizing Standard</h3>
              <p class="text-sm text-muted-dark">Minimum 7" depth by 7" drop required when running dual rollers (independent 3% solar screen paired with 100% blackout roller).</p>
            </div>
            <div class="p-6 border border-line-dark bg-forest/20">
              <span class="font-mono text-mono uppercase tracking-widest text-signal block mb-1">Specification 03</span>
              <h3 class="text-lg font-display text-on-dark mb-2">Low-Voltage Head Entry</h3>
              <p class="text-sm text-muted-dark">Motor wire drops inside pocket on motor jamb side, leaving 12" service loop to allow drive removal without touching finished ceilings.</p>
            </div>
          </div>
          <div class="lg:col-span-6 border border-line-dark p-4 bg-forest/10">
            <img 
              src="/images/davg-bedroom-shade-fascia-detail-01-800w.webp" 
              alt="Architectural pocket detail showing recessed shade fascia and framing blocking"
              class="w-full h-auto object-cover"
            />
            <div class="mt-4 font-mono text-mono text-quiet-dark uppercase">
              Plate 05-B — Pre-Drywall Head Condition Pocket Detail
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- CHAPTER 06: THE PROOF (Full-Bleed Verified Photography) -->
    <section class="relative bg-ink py-28 px-6 md:px-16 border-b border-line-dark">
      <div class="max-w-7xl mx-auto">
        <span class="font-mono text-xs tracking-widest text-signal uppercase block mb-4">
          06 / First-Party Evidence
        </span>
        <h2 class="text-h2 font-display font-light text-on-dark leading-tight tracking-tight max-w-3xl mb-12">
          Finished execution: Cherry Hills Village Residence.
        </h2>
        <div class="relative w-full aspect-[16/9] overflow-hidden border border-line-dark">
          <img 
            src="/images/davg-bedroom-motorized-shades-01-1600w.webp" 
            alt="Completed bedroom installation with Lutron motorized shades recessed into ceiling pocket"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-8 pt-8 border-t border-line-dark-soft font-mono text-xs text-muted-dark">
          <div>
            <span class="text-quiet-dark block uppercase mb-1">Project Location</span>
            <p class="text-on-dark">Cherry Hills Village, CO</p>
          </div>
          <div>
            <span class="text-quiet-dark block uppercase mb-1">Integration Scope</span>
            <p class="text-on-dark">18 motorized openings, recessed dual-roller pockets, Lutron HomeWorks QSX</p>
          </div>
          <div>
            <span class="text-quiet-dark block uppercase mb-1">System Delivery</span>
            <p class="text-on-dark">Pre-drywall framing coordination to final fabric drop calibration</p>
          </div>
        </div>
      </div>
    </section>
    <!-- CHAPTER 07: SCOPE & INVESTMENT FRAMING -->
    <section id="scope" class="relative bg-ink py-section px-page border-b border-line-dark">
      <div class="mx-auto flex max-w-7xl flex-col gap-8">
        <div class="flex flex-col gap-3">
          <span class="mono-label text-signal">07 / Scope & Investment Framing</span>
          <h2 class="text-h2 font-display font-light text-on-dark tracking-tight">
            Three scopes. The difference is engineering, not a menu.
          </h2>
          <p class="text-caption text-muted-dark max-w-measure">
            Scope is driven by window geometry, fabric openness specifications, structural pocket complexity, and integration depth.
          </p>
        </div>
        <GoodBetterBest
          title="Engineering scope"
          model="Scope / Experience tier"
          tone="dark"
          tiers={scopeTiers}
          note="Installed prices are scoped per residence. The difference is engineering depth and coordination — not a packaged menu."
        />
      </div>
    </section>
    <!-- CHAPTER 08: LOCAL KNOWLEDGE + LOCKED VERBATIM FAQ (Paper Surface) -->
    <section class="relative bg-paper text-on-paper py-28 px-6 md:px-16 border-b border-line-paper">
      <div class="max-w-6xl mx-auto">
        <span class="font-mono text-xs tracking-widest text-muted-paper uppercase block mb-4">
          08 / Local Knowledge & Verified FAQ
        </span>
        <h2 class="text-h2 font-display font-light text-on-paper leading-tight tracking-tight mb-12">
          Technical specifications & Front Range field answers.
        </h2>
        <!-- Locked Verbatim Q&A from DAVG_WEBSITE_SERVICE_FAQ_CANONICAL.md -->
        <div class="border-t border-b border-line-paper divide-y divide-[var(--color-border-paper)]">
          <div class="py-8">
            <h3 class="text-xl font-display font-normal text-on-paper mb-3">
              What's the structural requirement for mounting shades on a large window wall?
            </h3>
            <p class="text-base text-muted-paper leading-relaxed">
              Every Lutron motorized shade bracket has to land on blocking or another solid structural member, not drywall alone — the bracket carries the full weight and operating load of the shade continuously. On a floor-to-ceiling glass wall, that structural blocking has to be coordinated with the architect before drywall closes the wall, which is exactly why early involvement during framing matters more here than almost anywhere else in the build.
            </p>
          </div>
          <div class="py-8">
            <h3 class="text-xl font-display font-normal text-on-paper mb-3">
              How much pocket depth do motorized shades actually need?
            </h3>
            <p class="text-base text-muted-paper leading-relaxed">
              Pocket depth depends on shade width, fabric roll diameter, and whether the assembly is a single or dual (blackout-plus-sheer) configuration — commonly landing in a 3.5" to 7" range depending on those variables, not one universal number. The DAVG team sizes the pocket to the specific window and product line during design so the framing crew builds to a confirmed spec, not a retrofit guess.
            </p>
          </div>
          <div class="py-8">
            <h3 class="text-xl font-display font-normal text-on-paper mb-3">
              Are Lutron shades battery-powered or hardwired, and which is better?
            </h3>
            <p class="text-base text-muted-paper leading-relaxed">
              Both exist for real reasons. Battery-powered lines install without new wiring and suit retrofit projects where opening walls isn't practical. Hardwired shades suit whole-home new-construction projects where continuous reliability and zero battery maintenance outweigh install simplicity. The DAVG team specs based on the project and the wall's construction phase, not a default preference.
            </p>
          </div>
          <div class="py-8">
            <h3 class="text-xl font-display font-normal text-on-paper mb-3">
              Can motorized shades be added after construction, or do they need early planning?
            </h3>
            <p class="text-base text-muted-paper leading-relaxed">
              They can be added afterward, but the results improve measurably — cleaner pocket integration, no visible conduit, and no compromise on window sizing — when planned during design rather than retrofitted into a finished room. A retrofit shade has to work around what's already built; a planned shade is built around from the start.
            </p>
          </div>
          <div class="py-8">
            <h3 class="text-xl font-display font-normal text-on-paper mb-3">
              How quiet are these shades in actual operation?
            </h3>
            <p class="text-base text-muted-paper leading-relaxed">
              Lutron's Quiet Electronic Drive (QED) motors are engineered to run below the threshold that interrupts conversation or a movie, which matters most in a bedroom or theater where a mechanically loud shade motor would be a real functional problem, not a minor annoyance.
            </p>
          </div>
          <div class="py-8">
            <h3 class="text-xl font-display font-normal text-on-paper mb-3">
              Can shades be scheduled to respond to the sun automatically?
            </h3>
            <p class="text-base text-muted-paper leading-relaxed">
              Yes — shades can run on a fixed schedule, sunrise/sunset timing, or a solar sensor responding to actual glare and solar heat gain, removing the need to manually operate them as the sun moves across the property through the day.
            </p>
          </div>
          <div class="py-8">
            <h3 class="text-xl font-display font-normal text-on-paper mb-3">
              What distinguishes Palladiom from Lutron's other shade lines?
            </h3>
            <p class="text-base text-muted-paper leading-relaxed">
              Palladiom is Lutron's top-tier shade platform, engineered around a minimal architectural aesthetic and built to integrate with Lutron's highest-tier lighting and control ecosystem, including its own dedicated keypad design. Which line fits a given project depends on the specific window geometry and the rest of the home's finish level, which the DAVG team specs on a per-project basis.
            </p>
          </div>
          <div class="py-8">
            <h3 class="text-xl font-display font-normal text-on-paper mb-3">
              Do shades integrate with Lutron lighting scenes, or run independently?
            </h3>
            <p class="text-base text-muted-paper leading-relaxed">
              They're part of the same architecture — a "Movie" scene can lower shades and dim lights together in one action, and a "Good Morning" scene can raise shades on schedule, all triggered from the same keypad or app as the rest of the lighting system.
            </p>
          </div>
        </div>
      </div>
    </section>
    <!-- CHAPTER 09: DISCOVER / BEGIN (Juniper to Ink Surface Close) -->
    <section id="inquiry" class="relative bg-gradient-to-b from-[var(--color-surface-forest)] to-[var(--color-surface-ink)] py-28 px-6 md:px-16 border-t border-line-dark-soft">
      <div class="max-w-7xl mx-auto">
        <div class="mb-16">
          <span class="font-mono text-xs tracking-widest text-signal uppercase block mb-3">
            09 / Exploration & Engagement
          </span>
          <h2 class="text-h2 font-display font-light text-on-dark tracking-tight">
            Related architectural systems.
          </h2>
        </div>
        <!-- Canonical 8-Solution Inter-linking -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-20 font-mono text-xs border-t border-b border-line-dark py-8">
          <a href="/solutions/home-intelligence/" class="text-muted-dark hover:text-on-dark transition-colors">01 Home Intelligence →</a>
          <a href="/solutions/architectural-lighting/" class="text-muted-dark hover:text-on-dark transition-colors">02 Architectural Lighting →</a>
          <a href="/solutions/media-audio/" class="text-muted-dark hover:text-on-dark transition-colors">04 Media & Audio →</a>
          <a href="/solutions/private-cinemas/" class="text-muted-dark hover:text-on-dark transition-colors">05 Private Cinemas →</a>
          <a href="/solutions/security-access/" class="text-muted-dark hover:text-on-dark transition-colors">06 Security & Access →</a>
