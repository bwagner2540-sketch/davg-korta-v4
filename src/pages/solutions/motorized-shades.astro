---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ServicePage from '../../components/services/ServicePage.astro';

const entry = (await getCollection('services')).find((item) => item.data.slug === 'motorized-shades');
if (!entry) throw new Error('Motorized Shades content entry is missing.');
const { data: service } = entry;
---
<Layout title={service.seo.title} description={service.seo.description}>
  <ServicePage service={service} />
</Layout>
