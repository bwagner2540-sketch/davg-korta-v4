---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Motorized Shading — Architectural Daylight & Solar Automation | DAVG">
  <main class="min-h-screen bg-[var(--color-surface-ink)] text-[var(--color-text-primary-dark)] antialiased selection:bg-[var(--color-accent-signal)] selection:text-white">
    <!-- CHAPTER 01: RESIDENCE / HERO (Ink Surface) -->
    <section class="architectural-background-section min-h-[90vh] flex flex-col justify-between pt-32 pb-16 px-6 md:px-16 border-b border-[var(--color-border-dark)]">
      <div class="architectural-background-title select-none" data-surface="ink">
        DAYLIGHT
      </div>
      <div class="section-content max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-end">
        <div class="lg:col-span-8">
          <div class="inline-flex items-center gap-3 mb-6">
            <span class="w-2 h-2 rounded-full bg-[var(--color-accent-signal)]"></span>
            <span class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--color-text-secondary-dark)]">
              01 / Architectural Shading
            </span>
          </div>
          <h1 class="text-4xl md:text-6xl lg:text-7xl font-display font-light tracking-tight leading-[0.98] mb-8 text-[var(--color-text-primary-dark)]">
            Daylight harvested, glare managed, structure preserved.
          </h1>
          <p class="text-lg md:text-xl text-[var(--color-text-secondary-dark)] max-w-2xl font-light leading-relaxed">
            Motorized window treatments engineered into pre-construction pockets and window assemblies across South Metro Denver. Specified with the architecture, not mounted over trim after the fact.
          </p>
        </div>
        <div class="lg:col-span-4 border-l border-[var(--color-border-dark-soft)] pl-8 space-y-6">
          <div>
            <span class="block font-mono text-[11px] uppercase tracking-widest text-[var(--color-text-tertiary-dark)] mb-1">Operating Protocol</span>
            <p class="text-sm font-display text-[var(--color-text-primary-dark)]">Lutron HomeWorks QSX · Clear Connect Type X</p>
          </div>
          <div>
            <span class="block font-mono text-[11px] uppercase tracking-widest text-[var(--color-text-tertiary-dark)] mb-1">Front Range Solar Profile</span>
            <p class="text-sm font-display text-[var(--color-text-primary-dark)]">5,280' high-altitude UV mitigation & solar tracking</p>
          </div>
          <div>
            <span class="block font-mono text-[11px] uppercase tracking-widest text-[var(--color-text-tertiary-dark)] mb-1">Firm Verification</span>
            <p class="text-sm font-display text-[var(--color-text-primary-dark)]">Lutron Certified HomeWorks Integrator · Est. 2013</p>
          </div>
        </div>
      </div>
      <!-- Hero Visual Frame with Hairline Border -->
      <div class="section-visual max-w-7xl mx-auto w-full mt-12 pt-6 border-t border-[var(--color-border-dark-soft)]">
        <div class="relative w-full aspect-[21/9] overflow-hidden bg-[var(--color-surface-forest)]">
          <img 
            src="/images/davg-living-room-lutron-shades-orlando-01-1600w.webp" 
            alt="Floor-to-ceiling glass wall with recessed Lutron motorized shades overlooking Front Range landscape"
            class="w-full h-full object-cover opacity-80"
          />
          <div class="absolute bottom-4 left-6 font-mono text-[11px] tracking-widest uppercase text-[var(--color-text-primary-dark)] bg-[var(--color-surface-ink)]/70 px-3 py-1 border border-[var(--color-border-dark)]">
            Figure 1.1 — Recessed Dual-Roller Condition · Great Room
          </div>
        </div>
      </div>
    </section>
    <!-- CHAPTER 02: THE ANSWER (Paper Editorial Reset) -->
    <section class="relative bg-[var(--color-surface-paper)] text-[var(--color-text-primary-paper)] py-28 px-6 md:px-16 border-b border-[var(--color-border-paper)]">
      <div class="max-w-6xl mx-auto">
        <span class="font-mono text-xs tracking-[0.2em] text-[var(--color-text-secondary-paper)] uppercase block mb-4">
          02 / The Definitive Answer
        </span>
        <h2 class="text-3xl md:text-5xl font-display font-light text-[var(--color-text-primary-paper)] leading-tight tracking-tight max-w-4xl mb-10">
          A motorized shade is an integrated envelope system, not an aftermarket blind.
        </h2>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 border-t border-[var(--color-border-paper)] pt-10">
          <div class="lg:col-span-7 space-y-6 text-base text-[var(--color-text-secondary-paper)] leading-relaxed">
            <p class="text-lg text-[var(--color-text-primary-paper)] font-normal">
              Typical pocket depth for motorized Lutron Palladiom shades behind a floor-to-ceiling window wall is 5.5 to 7.5 inches, with low-voltage clearance reserved in the head condition before drywall. Undersize either dimension and the fabric roll binds against trim within a season.
            </p>
            <p>
              Motorized shading integrates four distinct layers: performance architectural fabric (openness factor and emissivity), precision tubular drives operating below conversation decibels, digital control bus architecture (Lutron QS Link or wireless Clear Connect), and continuous low-voltage power infrastructure homerun back to a central equipment core.
            </p>
            <p>
              When engineered during schematic framing, motorized window treatments eliminate visible wiring, expose zero mounting brackets, and coordinate with reflected ceiling plans to drop invisibly from flush ceiling pockets.
            </p>
          </div>
          <div class="lg:col-span-5 border-l border-[var(--color-border-paper)] pl-8 space-y-6">
            <div class="pb-6 border-b border-[var(--color-border-paper)]">
              <span class="font-mono text-xs uppercase tracking-widest text-[var(--color-text-secondary-paper)] block mb-1">Primary Dimension</span>
              <p class="font-display text-2xl text-[var(--color-text-primary-paper)]">5.5" – 7.5" Pocket Depth</p>
              <span class="font-mono text-[11px] text-[var(--color-text-secondary-paper)]">Single or dual roller clearance</span>
            </div>
            <div class="pb-6 border-b border-[var(--color-border-paper)]">
              <span class="font-mono text-xs uppercase tracking-widest text-[var(--color-text-secondary-paper)] block mb-1">Acoustic Floor</span>
              <p class="font-display text-2xl text-[var(--color-text-primary-paper)]">&lt; 38 dBA Sound Level</p>
              <span class="font-mono text-[11px] text-[var(--color-text-secondary-paper)]">Lutron Quiet Electronic Drive (QED)</span>
            </div>
            <div>
              <span class="font-mono text-xs uppercase tracking-widest text-[var(--color-text-secondary-paper)] block mb-1">Wiring Standard</span>
              <p class="font-display text-2xl text-[var(--color-text-primary-paper)]">16/2 AWG + Cat6 Low-Voltage</p>
              <span class="font-mono text-[11px] text-[var(--color-text-secondary-paper)]">Homerun to central power distribution panel</span>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- CHAPTER 03: DAVG SYSTEM STUDY (Deep Forest / Juniper Surface) -->
    <section class="architectural-background-section bg-[var(--color-surface-forest)] text-[var(--color-text-primary-dark)] py-28 px-6 md:px-16 border-b border-[var(--color-border-dark-soft)]">
      <div class="architectural-background-title select-none" data-surface="juniper">
        SOLAR STUDY
      </div>
      <div class="section-content max-w-7xl mx-auto">
        <div class="max-w-3xl mb-16">
          <span class="font-mono text-xs tracking-[0.2em] text-[var(--color-accent-signal)] uppercase block mb-3">
            03 / Signature System Study
          </span>
          <h2 class="text-3xl md:text-5xl font-display font-light leading-tight tracking-tight mb-6">
            Solar Geometry Study: Front Range Altitude & Thermal Control
          </h2>
          <p class="text-base text-[var(--color-text-secondary-dark)] leading-relaxed">
            At 5,280 feet, ultraviolet exposure and low-angle winter solar gain degrade interiors and overheat living zones. Motorized shades operate as automated thermal baffles based on calculated solar azimuth.
          </p>
        </div>
        <!-- System Study 6-Part Crawlable HTML Ledger -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 border-t border-[var(--color-border-dark)] pt-8">
          <div class="space-y-8">
            <div>
              <span class="font-mono text-[11px] uppercase tracking-widest text-[var(--color-accent-signal)] block mb-2">1. What You Are Evaluating</span>
              <p class="text-sm text-[var(--color-text-secondary-dark)] leading-relaxed">
                Calculated solar angles across southern and western glass exposures. Low-angle winter sun penetrates deeply into living volumes, causing severe glare, while summer sun increases air conditioning load exponentially.
              </p>
            </div>
            <div>
              <span class="font-mono text-[11px] uppercase tracking-widest text-[var(--color-accent-signal)] block mb-2">2. Why It Matters to Architecture</span>
              <p class="text-sm text-[var(--color-text-secondary-dark)] leading-relaxed">
                Automated fabric positioning preserves view lines while stopping up to 85% of solar radiation before it converts to interior heat, protecting wide-plank hardwood floors and fine art from photodegradation.
              </p>
            </div>
            <div>
              <span class="font-mono text-[11px] uppercase tracking-widest text-[var(--color-accent-signal)] block mb-2">3. What DAVG Evaluates</span>
              <p class="text-sm text-[var(--color-text-secondary-dark)] leading-relaxed">
                Fabric openness factors (1%, 3%, 5%, or blackout), internal weave reflection coefficients, bracket deflection under load, and roll-diameter clearance inside ceiling assemblies.
              </p>
            </div>
          </div>
          <div class="space-y-8 lg:border-l lg:border-[var(--color-border-dark-soft)] lg:pl-12">
            <div>
              <span class="font-mono text-[11px] uppercase tracking-widest text-[var(--color-accent-signal)] block mb-2">4. What Commonly Goes Wrong</span>
              <p class="text-sm text-[var(--color-text-secondary-dark)] leading-relaxed">
                Undersized pockets that crush fabric hems, unbacked drywall anchors that sag under 40-pound shade assemblies, and noisy line-voltage motors that turn wake-up routines into industrial rattle.
              </p>
            </div>
            <div>
              <span class="font-mono text-[11px] uppercase tracking-widest text-[var(--color-accent-signal)] block mb-2">5. How DAVG Verifies & Delivers</span>
              <p class="text-sm text-[var(--color-text-secondary-dark)] leading-relaxed">
                Laser measurement of window frames post-drywall, CAD blocking diagrams provided to framers at framing stage, hembar tolerance verification, and astronomical clock commissioning.
              </p>
            </div>
            <div>
              <span class="font-mono text-[11px] uppercase tracking-widest text-[var(--color-accent-signal)] block mb-2">6. Related System Decision</span>
              <p class="text-sm text-[var(--color-text-secondary-dark)] leading-relaxed">
                Coordinate shade automation directly with <a href="/solutions/architectural-lighting/" class="text-[var(--color-text-primary-dark)] underline decoration-[var(--color-accent-signal)] underline-offset-4">Architectural Lighting</a> and <a href="/solutions/home-intelligence/" class="text-[var(--color-text-primary-dark)] underline decoration-[var(--color-accent-signal)] underline-offset-4">Home Intelligence</a> for unified circadian wake and evening scenes.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- CHAPTER 04: THE DECISION (Cream / Paper Surface) -->
    <section class="relative bg-[var(--color-surface-paper)] text-[var(--color-text-primary-paper)] py-28 px-6 md:px-16 border-b border-[var(--color-border-paper)]">
      <div class="max-w-7xl mx-auto">
        <span class="font-mono text-xs tracking-[0.2em] text-[var(--color-text-secondary-paper)] uppercase block mb-4">
          04 / Decision Framework
        </span>
        <h2 class="text-3xl md:text-5xl font-display font-light text-[var(--color-text-primary-paper)] leading-tight tracking-tight max-w-3xl mb-12">
          Comparing shade architectures: hardwired vs. wireless retrofit.
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 border-t border-b border-[var(--color-border-paper)] divide-y md:divide-y-0 md:divide-x divide-[var(--color-border-paper)]">
          <div class="py-10 md:pr-12">
            <span class="font-mono text-[11px] uppercase tracking-widest text-[var(--color-text-secondary-paper)] block mb-2">Architecture 01</span>
            <h3 class="text-2xl font-display font-normal text-[var(--color-text-primary-paper)] mb-4">Hardwired Low-Voltage (Pre-Construction)</h3>
            <p class="text-sm text-[var(--color-text-secondary-paper)] leading-relaxed mb-6">
              Low-voltage wiring pulled home to central Lutron panels. Ideal for new builds, additions, and studs-up remodels where ceiling cavities remain accessible.
            </p>
            <ul class="space-y-3 font-mono text-xs text-[var(--color-text-secondary-paper)]">
              <li class="flex items-center gap-2"><span class="text-[var(--color-accent-signal)]">✓</span> Zero battery maintenance forever</li>
              <li class="flex items-center gap-2"><span class="text-[var(--color-accent-signal)]">✓</span> Supports ultra-quiet Palladiom exposed architectural brackets</li>
              <li class="flex items-center gap-2"><span class="text-[var(--color-accent-signal)]">✓</span> Perfectly synchronized hembar alignment across multi-window spans</li>
              <li class="flex items-center gap-2"><span class="text-red-700">✕</span> Requires low-voltage rough-in before insulation and drywall</li>
            </ul>
          </div>
          <div class="py-10 md:pl-12">
            <span class="font-mono text-[11px] uppercase tracking-widest text-[var(--color-text-secondary-paper)] block mb-2">Architecture 02</span>
            <h3 class="text-2xl font-display font-normal text-[var(--color-text-primary-paper)] mb-4">Battery RF Wireless (Occupied Retrofit)</h3>
            <p class="text-sm text-[var(--color-text-secondary-paper)] leading-relaxed mb-6">
              Operates on standard D-cell alkaline batteries using Clear Connect RF. Ideal for completed homes where running new wiring through finished ceilings is cost-prohibitive.
            </p>
            <ul class="space-y-3 font-mono text-xs text-[var(--color-text-secondary-paper)]">
              <li class="flex items-center gap-2"><span class="text-[var(--color-accent-signal)]">✓</span> Installs without opening drywall or repainting</li>
              <li class="flex items-center gap-2"><span class="text-[var(--color-accent-signal)]">✓</span> 3–5 year battery life under typical daily operation</li>
              <li class="flex items-center gap-2"><span class="text-[var(--color-accent-signal)]">✓</span> Full keypad, app, and scene integration with Control4/Lutron</li>
              <li class="flex items-center gap-2"><span class="text-red-700">✕</span> Limited to enclosed cassette headrails to conceal battery pack</li>
            </ul>
          </div>
        </div>
      </div>
    </section>
    <!-- CHAPTER 05: BEHIND THE ARCHITECTURE (Near-Black Technical Detail) -->
    <section class="relative bg-[var(--color-surface-ink)] text-[var(--color-text-primary-dark)] py-28 px-6 md:px-16 border-b border-[var(--color-border-dark)]">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-3xl mb-16">
          <span class="font-mono text-xs tracking-[0.2em] text-[var(--color-accent-signal)] uppercase block mb-3">
            05 / Behind The Architecture
          </span>
          <h2 class="text-3xl md:text-5xl font-display font-light leading-tight tracking-tight mb-6">
            Structural blocking, pocket coordination, and wiring pathways.
          </h2>
          <p class="text-base text-[var(--color-text-secondary-dark)] leading-relaxed">
            Every bracket carries the full weight and continuous operating torque of the shade. We coordinate low-voltage rough-in and structural framing before walls close.
          </p>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <div class="lg:col-span-6 space-y-4">
            <div class="p-6 border border-[var(--color-border-dark)] bg-[var(--color-surface-forest)]/20">
              <span class="font-mono text-[11px] uppercase tracking-widest text-[var(--color-accent-signal)] block mb-1">Specification 01</span>
              <h3 class="text-lg font-display text-[var(--color-text-primary-dark)] mb-2">Structural Continuous Blocking</h3>
              <p class="text-sm text-[var(--color-text-secondary-dark)]">Solid 2x wood blocking secured to header structure. Shades are never anchored to drywall, plaster, or hollow window jambs.</p>
            </div>
            <div class="p-6 border border-[var(--color-border-dark)] bg-[var(--color-surface-forest)]/20">
              <span class="font-mono text-[11px] uppercase tracking-widest text-[var(--color-accent-signal)] block mb-1">Specification 02</span>
              <h3 class="text-lg font-display text-[var(--color-text-primary-dark)] mb-2">Dual Pocket Sizing Standard</h3>
              <p class="text-sm text-[var(--color-text-secondary-dark)]">Minimum 7" depth by 7" drop required when running dual rollers (independent 3% solar screen paired with 100% blackout roller).</p>
            </div>
            <div class="p-6 border border-[var(--color-border-dark)] bg-[var(--color-surface-forest)]/20">
              <span class="font-mono text-[11px] uppercase tracking-widest text-[var(--color-accent-signal)] block mb-1">Specification 03</span>
              <h3 class="text-lg font-display text-[var(--color-text-primary-dark)] mb-2">Low-Voltage Head Entry</h3>
              <p class="text-sm text-[var(--color-text-secondary-dark)]">Motor wire drops inside pocket on motor jamb side, leaving 12" service loop to allow drive removal without touching finished ceilings.</p>
            </div>
          </div>
          <div class="lg:col-span-6 border border-[var(--color-border-dark)] p-4 bg-[var(--color-surface-forest)]/10">
            <img 
              src="/images/davg-bedroom-shade-fascia-detail-01-800w.webp" 
              alt="Architectural pocket detail showing recessed shade fascia and framing blocking"
              class="w-full h-auto object-cover"
            />
            <div class="mt-4 font-mono text-[11px] text-[var(--color-text-tertiary-dark)] uppercase">
              Plate 05-B — Pre-Drywall Head Condition Pocket Detail
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- CHAPTER 06: THE PROOF (Full-Bleed Verified Photography) -->
    <section class="relative bg-[var(--color-surface-ink)] py-28 px-6 md:px-16 border-b border-[var(--color-border-dark)]">
      <div class="max-w-7xl mx-auto">
        <span class="font-mono text-xs tracking-[0.2em] text-[var(--color-accent-signal)] uppercase block mb-4">
          06 / First-Party Evidence
        </span>
        <h2 class="text-3xl md:text-5xl font-display font-light text-[var(--color-text-primary-dark)] leading-tight tracking-tight max-w-3xl mb-12">
          Finished execution: Cherry Hills Village Residence.
        </h2>
        <div class="relative w-full aspect-[16/9] overflow-hidden border border-[var(--color-border-dark)]">
          <img 
            src="/images/davg-bedroom-motorized-shades-01-1600w.webp" 
            alt="Completed bedroom installation with Lutron motorized shades recessed into ceiling pocket"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-8 pt-8 border-t border-[var(--color-border-dark-soft)] font-mono text-xs text-[var(--color-text-secondary-dark)]">
          <div>
            <span class="text-[var(--color-text-tertiary-dark)] block uppercase mb-1">Project Location</span>
            <p class="text-[var(--color-text-primary-dark)]">Cherry Hills Village, CO</p>
          </div>
          <div>
            <span class="text-[var(--color-text-tertiary-dark)] block uppercase mb-1">Integration Scope</span>
            <p class="text-[var(--color-text-primary-dark)]">18 motorized openings, recessed dual-roller pockets, Lutron HomeWorks QSX</p>
          </div>
          <div>
            <span class="text-[var(--color-text-tertiary-dark)] block uppercase mb-1">System Delivery</span>
            <p class="text-[var(--color-text-primary-dark)]">Pre-drywall framing coordination to final fabric drop calibration</p>
          </div>
        </div>
      </div>
    </section>
    <!-- CHAPTER 07: SCOPE & INVESTMENT FRAMING (3-Column 1px Hairline Grid) -->
    <section class="relative bg-[var(--color-surface-ink)] py-28 px-6 md:px-16 border-b border-[var(--color-border-dark)]">
      <div class="max-w-7xl mx-auto">
        <div class="mb-16">
          <span class="font-mono text-xs tracking-[0.2em] text-[var(--color-accent-signal)] uppercase block mb-3">
            07 / Scope & Investment Framing
          </span>
          <h2 class="text-3xl md:text-5xl font-display font-light text-[var(--color-text-primary-dark)] tracking-tight">
            Three scopes. The difference is engineering, not a menu.
          </h2>
          <p class="text-sm text-[var(--color-text-secondary-dark)] mt-4 max-w-2xl leading-relaxed">
            Scope is driven by window geometry, fabric openness specifications, structural pocket complexity, and integration depth.
          </p>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-3 border-t border-b border-[var(--color-border-dark)] divide-y lg:divide-y-0 lg:divide-x divide-[var(--color-border-dark)]">
          <!-- Room Tier -->
          <div class="py-12 lg:px-8 first:pl-0">
            <span class="font-mono text-[10px] tracking-widest text-[var(--color-accent-signal)]">01 / ROOM</span>
            <h3 class="text-2xl font-display text-[var(--color-text-primary-dark)] mt-2 mb-4">Room-Level Focus</h3>
            <p class="text-sm text-[var(--color-text-secondary-dark)] mb-8 leading-relaxed">
              Targeted automation for primary spaces: master bedroom blackout shades or great room solar management.
            </p>
            <div class="space-y-6 pt-6 border-t border-[var(--color-border-dark-soft)]">
              <div>
                <span class="block font-mono text-[10px] tracking-widest text-[var(--color-text-tertiary-dark)] uppercase mb-1">Includes</span>
                <p class="text-sm text-[var(--color-text-primary-dark)]">Lutron wireless or hardwired shades, Pico or Palladiom keypads, local scene control</p>
              </div>
              <div>
                <span class="block font-mono text-[10px] tracking-widest text-[var(--color-text-tertiary-dark)] uppercase mb-1">Solves</span>
                <p class="text-sm text-[var(--color-text-primary-dark)]">Hard-to-reach clerestory windows, daily manual adjustments, morning light bleed</p>
              </div>
              <div>
                <span class="block font-mono text-[10px] tracking-widest text-[var(--color-text-tertiary-dark)] uppercase mb-1">Right For</span>
                <p class="text-sm text-[var(--color-text-primary-dark)]">Single-room renovations and occupied home refreshes</p>
              </div>
            </div>
          </div>
          <!-- Home Tier -->
          <div class="py-12 lg:px-8">
            <span class="font-mono text-[10px] tracking-widest text-[var(--color-accent-signal)]">02 / HOME</span>
            <h3 class="text-2xl font-display text-[var(--color-text-primary-dark)] mt-2 mb-4">Whole-Home Coordination</h3>
            <p class="text-sm text-[var(--color-text-secondary-dark)] mb-8 leading-relaxed">
              All primary window elevations synchronized across solar tracking, lighting scenes, and security modes.
            </p>
            <div class="space-y-6 pt-6 border-t border-[var(--color-border-dark-soft)]">
              <div>
                <span class="block font-mono text-[10px] tracking-widest text-[var(--color-text-tertiary-dark)] uppercase mb-1">Includes</span>
                <p class="text-sm text-[var(--color-text-primary-dark)]">HomeWorks QSX processor, hardwired low-voltage panels, full astronomical clock automation</p>
              </div>
              <div>
                <span class="block font-mono text-[10px] tracking-widest text-[var(--color-text-tertiary-dark)] uppercase mb-1">Solves</span>
                <p class="text-sm text-[var(--color-text-primary-dark)]">Walking room-to-room to close shades; whole-house thermal gain on western exposures</p>
              </div>
              <div>
                <span class="block font-mono text-[10px] tracking-widest text-[var(--color-text-tertiary-dark)] uppercase mb-1">Right For</span>
                <p class="text-sm text-[var(--color-text-primary-dark)]">Substantial residential renovations and custom builds</p>
              </div>
            </div>
          </div>
          <!-- Estate Tier -->
          <div class="py-12 lg:px-8 last:pr-0">
            <span class="font-mono text-[10px] tracking-widest text-[var(--color-accent-signal)]">03 / ESTATE</span>
            <h3 class="text-2xl font-display text-[var(--color-text-primary-dark)] mt-2 mb-4">Estate-Level Architecture</h3>
            <p class="text-sm text-[var(--color-text-secondary-dark)] mb-8 leading-relaxed">
              Zero-compromise integration from schematic architectural planning through long-term concierge stewardship.
            </p>
