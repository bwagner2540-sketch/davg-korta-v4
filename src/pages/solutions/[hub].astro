---
import '../../styles/global.css';
import HubFrame from '../../components/HubFrame.astro';
import { parseHubMarkdown, type HubDocument } from '../../lib/hub-markdown';

export function getStaticPaths() {
  const modules = import.meta.glob('../../../docs/v4-build/hubs/*.md', {
    query: '?raw',
    import: 'default',
    eager: true,
  });

  return Object.values(modules)
    .map((raw) => parseHubMarkdown(String(raw)))
    .filter((hub) => hub.slug && hub.slug !== 'motorized-shades')
    .map((hub) => ({
      params: { hub: hub.slug },
      props: { hub },
    }));
}

interface Props {
  hub: HubDocument;
}

const { hub } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{hub.seoTitle}</title>
    {hub.description && <meta name="description" content={hub.description} />}
  </head>
  <body class="bg-surface-paper text-text-primary-paper antialiased">
    <a class="skip" href="#s01">Skip to content</a>
    <HubFrame hub={hub} />
  </body>
</html>
