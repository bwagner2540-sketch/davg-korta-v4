---
import Layout from '../../layouts/Layout.astro';
import { services } from '../../config/site';

const origin = 'http://127.0.0.1:4321';
const pages = [
  { label: 'Home', href: `${origin}/` },
  ...services.map((service) => ({ label: service.railLabel, href: `${origin}${service.href}` })),
];
---
<Layout published={false} title="Local preview" description="Local review index for the DAVG site. Not for publication.">
  <main class="preview-index">
    <h1>Local preview</h1>
    <p>Refresh <a href={`${origin}/preview/`}>{origin}/preview/</a> after each local change.</p>
    <ol>
      {pages.map((page) => (
        <li><a href={page.href}>{page.label}</a></li>
      ))}
    </ol>
  </main>
</Layout>
<style>
.preview-index {
  padding: var(--spacing-16) var(--spacing-page-inline) var(--spacing-12);
  max-width: 40rem;
}
.preview-index h1 {
  margin: 0 0 1rem;
  font-family: var(--font-display);
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 400;
}
.preview-index p,
.preview-index li { font-family: var(--font-body); line-height: 1.5; }
.preview-index ol {
  display: grid;
  gap: 0.75rem;
  margin: 2rem 0 0;
  padding: 0;
  list-style: decimal inside;
}
.preview-index a { color: inherit; text-decoration: none; }
.preview-index a:hover { color: var(--color-accent-signal); }
</style>
